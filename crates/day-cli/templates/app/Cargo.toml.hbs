[package]
name = "{{name}}"
version.workspace = true
edition = "2024"

[features]
# `mock` keeps bare cargo and rust-analyzer compiling; `day build` overrides it with
# `--no-default-features --features <backend>` (https://daybrite.dev/docs/reference/project-structure).
default = ["mock"]
appkit = ["day/appkit"]
gtk = ["day/gtk"]
qt = ["day/qt"]
uikit = ["day/uikit"]
material = ["day/material"]
winui = ["day/winui"]
arkui = ["day/arkui"]
dom = ["day/dom"]
mock = ["day/mock"]

# Cargo defaults to rlib; the mobile pipeline requests staticlib/cdylib via `cargo rustc`.
[lib]
# A constant lib name: staged artifacts and the `dayapp::` import never move on a package rename.
name = "dayapp"

[dependencies]
{{day_dep}}
{{day_piece_deps}}
# The items are saved as JSON in the preferences (src/model.rs).
serde = { version = "1", features = ["derive"] }

[build-dependencies]
{{day_build_dep}}

# Lint policy: Clippy's default lints plus a short list that catches defects rather than style.
# The project's CI treats every warning as an error (`cargo clippy --all-targets -- -D warnings`),
# so a finding blocks the change that introduced it. Fix findings in the code; for a site where
# the lint is wrong, use `#[expect(clippy::<lint>, reason = "…")]`. A stricter table, up to
# Clippy's `pedantic` group, is the project's choice; keep these lines in it.
[lints.clippy]
{{app_clippy_lints}}

[workspace]

[workspace.package]
version = "0.1.0"
