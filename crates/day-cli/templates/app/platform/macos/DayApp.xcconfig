// Xcode build settings for the macOS app; Xcode's own settings and `day build` override them.
// https://daybrite.dev/docs/reference/project-structure#xcode-build-settings

// Fallbacks for a checkout that has not built yet; the generated include below sets these from
// Day.toml [app] and Cargo.toml [package] on every `day build`.
PRODUCT_NAME = {{pascal}}
DAY_APP_TITLE = {{title}}
PRODUCT_BUNDLE_IDENTIFIER = {{id}}
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// The oldest macOS the app runs on. `day build` raises it when a Day piece needs a newer one.
MACOSX_DEPLOYMENT_TARGET = 13.0

// Any other build setting goes here, for example:
//INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity

// Generated by `day build` from Day.toml.
#include? "../../build/day/xcconfig/macos.xcconfig"

// Per-checkout settings such as DEVELOPMENT_TEAM, gitignored and applied last.
#include? "DayApp.local.xcconfig"
