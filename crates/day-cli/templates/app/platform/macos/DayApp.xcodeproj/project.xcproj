{
  "default-configuration": "Debug",
  "configurations": [
    { "name": "Debug", "file": "DayApp.xcconfig" },
    { "name": "Release", "file": "DayApp.xcconfig" },
  ],
  "localizations": { "development": "en" },
  "packages": [
    {
      "kind": "local",
      "path": "../../build/day/macos/DayPieces",
    },
  ],
  "files": [
    {
      "kind": "group",
      "name": "App",
      "path": "../..",
      "children": [
        { "path": "Cargo.toml" },
        { "path": "Day.toml" },
        { "path": "src" },
        { "path": "resource" },
      ],
    },
    {
      "kind": "group",
      "path": "Runner",
      "children": [
        { "path": "main.swift", "target-membership": [ "Runner/compile-sources" ] },
        { "path": "Info.plist" },
      ],
    },
    { "path": "../../build/day/host/macos/Assets.xcassets", "target-membership": [ "Runner/resources" ] },
    { "path": "DayApp.xcconfig" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/DayApp.app" },
      ],
    },
  ],
  "targets": [
    {
      "name": "Runner",
      "id": "Runner",
      "product": "Products/DayApp.app",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Build Rust (day)",
          "output-paths": [
            "$(BUILT_PRODUCTS_DIR)/day/libdayapp.a",
            "$(BUILT_PRODUCTS_DIR)/day/dayapp-link.rsp",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/bin/sh \"$PROJECT_DIR/day-cli.sh\" xcode-backend build\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Stage Resources (day)",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/bin/sh \"$PROJECT_DIR/day-cli.sh\" xcode-backend stage-resources\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "DayPieces",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "COMBINE_HIDPI_IMAGES": "YES",
        "INFOPLIST_FILE": "Runner/Info.plist",
        "OTHER_LDFLAGS": "@\"$(BUILT_PRODUCTS_DIR)/day/dayapp-link.rsp\"",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "6.0",
  },
}
