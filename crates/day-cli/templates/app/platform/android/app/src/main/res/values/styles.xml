<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: Material 3 Expressive (new motion/shape/typography system, material 1.13+),
         follows the system light/dark setting (DayNight), no framework ActionBar (Day renders its
         own nav/toolbar chrome). Requires com.google.android.material. -->
    <style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- Status bar: the app's own surface, with icons in the matching polarity. Left at the
             Material default it paints colorPrimary, which reads as a colored band above a
             surface-colored app bar in light and clashes outright in dark, where primary is a
             pale tone. Both attributes resolve per scheme (?attr/isLightTheme is true in the day
             half of DayNight), so one declaration covers both. Android 15+ (targetSdk 35) forces
             edge-to-edge and ignores statusBarColor — there the window background shows through
             instead, which is this same surface. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <!-- Text actions in an app bar ("Done", "Edit") in sentence case, as Material 3 sets
             them. AppCompat's action button style still capitalizes them, a Material 2 look
             that nothing else in the theme shares. -->
        <item name="actionButtonStyle">@style/AppTheme.ActionButton</item>
    </style>

    <style name="AppTheme.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
