# Before a push to main, resolve the downstream repositories against the commit being pushed.
#
# Every external part, piece and app takes the framework from this repository's git URL with no
# revision pinned, so a push to main is also a change to each of their next CI runs, and a
# rename or removal here that none of them has followed yet turns every one of them red. Local
# builds cannot show that: `day patch --local` points each sibling checkout at the others, so
# the trees on this machine resolve while the trees as pushed do not. The check exports the
# siblings at their upstream refs and asks `day patch --check` the question CI will ask
# (scripts/ci/downstream-check.py has the details and the verdicts).
#
# The hook passes when every sibling resolves or has a fix in HEAD or its working tree. Pending
# downstream commits and pushes produce warnings; only failures without a local fix block day.
# Pushes of other branches and of tags are not checked.
# Skip once with `git push --no-verify`, or with DAY_SKIP_DOWNSTREAM=1 in the environment.
#
# Tracked here and wired up with `git config core.hooksPath .githooks` (scripts/install-hooks.sh).
set -euo pipefail

if [ "${DAY_SKIP_DOWNSTREAM:-}" = "1" ]; then
    exit 0
fi

# stdin: one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        to_main=1
    fi
done
if [ "$to_main" -eq 0 ]; then
    exit 0
fi

echo "pre-push: resolving the downstream repositories against the commit being pushed"
echo "          (skip once with --no-verify, or DAY_SKIP_DOWNSTREAM=1)"
python3 -B scripts/ci/downstream-check.py
