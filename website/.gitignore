# build output
dist/

# Local blog drafts; the content loader also excludes these from production builds.
/src/content/blog/**/drafts/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# day gallery: the manifest assembled from the apps' published indexes, and the cached copy of
# each index (so a build survives an unreachable app site, and works offline once warm)
/src/data/gallery-manifest.json
/.cache/

# day hero carousel: verified front-page screenshots + manifest (generated by scripts/hero-shots.mjs)
/public/hero/
/src/data/hero-shots.json


# day showcase downloads: packaged apps + manifest assembled from showcase-dist-* CI artifacts
# (scripts/assemble-downloads.mjs)
/public/downloads/
/src/data/downloads.json

# Optional local Copyedit configuration (the normal build stays independent of it)
/astro.copyedit.config.mjs

# Verified, generated screenshot renditions from pinned release bundles.
/public/gallery-media/

# Compiled landing-page app, generated from apps/website-controls on build/dev startup.
/public/demos/shared-signal/
/src/data/live-demo.json
