# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# day gallery: the manifest assembled from the apps' published indexes, and the cached copy of
# each index (so a build survives an unreachable app site, and works offline once warm)
/src/data/gallery-manifest.json
/.cache/

# day hero carousel: verified front-page screenshots + manifest (generated by scripts/hero-shots.mjs)
/public/hero/
/src/data/hero-shots.json

# day API reference: locally-generated rustdoc bundle for previewing /docs/api
# (`scripts/build-api-docs.sh --out website/public/api`). In CI it lands in dist/api instead.
/public/api/

# day showcase downloads: packaged apps + manifest assembled from showcase-dist-* CI artifacts
# (scripts/assemble-downloads.mjs)
/public/downloads/
/src/data/downloads.json
