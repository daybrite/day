// SPDX-License-Identifier: CC-BY-SA-4.0
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url, internalTitle } from '../lib/site';
import { navigation, groupOf } from '../lib/docs-navigation.mjs';
import { orderedIds } from '../lib/internal-groups.mjs';

interface Props { title: string; description?: string; slug?: string; active?: string }
const { title, description, slug, active = 'docs' } = Astro.props;

// Highlight the pinned "API reference" sidebar link when we're on that page.
const isApi = Astro.url.pathname.replace(/\/$/, '').endsWith('/docs/api');

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

// The prev/next pager: within the curated docs normally, and within the internal reference's
// own curated order (src/lib/internal-groups.mjs) on an internal page — before this, internal
// pages passed no slug, so the pager silently vanished and the sidebar highlighted nothing.
let prev: { href: string; title: string } | null = null;
let next: { href: string; title: string } | null = null;
if (active === 'internal' && slug) {
  const internal = await getCollection('internal');
  const titleOf = (id: string) =>
    internal.find((e) => e.id === id)?.data.title ?? internalTitle(id);
  const i = orderedIds.indexOf(slug);
  if (i > 0) prev = { href: url(`docs/internal/${orderedIds[i - 1]}`), title: titleOf(orderedIds[i - 1]) };
  if (i >= 0 && i < orderedIds.length - 1)
    next = { href: url(`docs/internal/${orderedIds[i + 1]}`), title: titleOf(orderedIds[i + 1]) };
} else {
  const current = docs.find((d) => d.id === slug);
  const sequence = current ? docs.filter((d) => groupOf(d) === groupOf(current)) : [];
  const idx = sequence.findIndex((d) => d.id === slug);
  if (idx > 0) prev = { href: url(`docs/${sequence[idx - 1].id}`), title: sequence[idx - 1].data.title };
  if (idx >= 0 && idx < sequence.length - 1)
    next = { href: url(`docs/${sequence[idx + 1].id}`), title: sequence[idx + 1].data.title };
}

const sections = navigation(docs);

---
<BaseLayout title={title} description={description} active={active}>
  <div class="docs container">
    <aside class="sidebar" data-pagefind-ignore>
      <nav aria-label="Documentation">
        <a class="side-link" href={url('docs')}>Documentation home</a>
        {sections.map((s) => (
          <details open={s.pages.some((d) => d.id === slug) || (s.name === 'Reference' && isApi) || (s.name === 'Contribute' && active === 'internal')}>
            <summary class="side-h">{s.name}</summary>
            {s.pages.map((d) => (
              <a
                href={url(`docs/${d.id}`)}
                class:list={['side-link', { on: d.id === slug }]}
                title={d.data.navTitle ? d.data.title : undefined}
              >
                {d.data.navTitle ?? d.data.title}
              </a>
            ))}
            {s.name === 'Reference' && <a href={url('docs/api')} class:list={['side-link', { on: isApi }]}>API reference</a>}
            {s.name === 'Contribute' && <a href={url('docs/internal')} class:list={['side-link', { on: active === 'internal' }]}>Implementation notes</a>}
          </details>
        ))}

      </nav>
    </aside>

    <article class="doc-body">
      <slot />
      {(prev || next) && (
        <nav class="prevnext" aria-label="Pagination" data-pagefind-ignore>
          {prev ? (
            <a href={prev.href} class="pn"><span>← Previous</span><b>{prev.title}</b></a>
          ) : <span />}
          {next ? (
            <a href={next.href} class="pn next"><span>Next →</span><b>{next.title}</b></a>
          ) : <span />}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: 48px;
    padding-block: 44px 72px;
    align-items: start;
  }
  .sidebar {
    position: sticky;
    top: 82px;
    align-self: start;
    /* The nav is taller than the viewport, and a sticky box taller than the viewport pins
       immediately and only yields when the container's bottom pushes it — so everything below
       the fold was unreachable until the page was nearly fully scrolled. Capping the box at
       the viewport (minus the 82px header offset and a little breathing room) makes the
       sidebar scroll ITS OWN content under the cursor instead; `overscroll-behavior` keeps a
       wheel at either end from spilling into the page scroll. */
    max-height: calc(100vh - 98px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 6px;
  }
  .sidebar details { margin-top: 16px; }
  summary.side-h { cursor: pointer; padding: 8px 0; }
  .side-h {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    color: var(--faint);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .side-h:not(:first-child) { margin-top: 20px; }
  .side-link {
    display: block;
    padding: 8px 12px;
    border-radius: 9px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    border-left: 2px solid transparent;
  }
  .side-link:hover { background: var(--hover); color: var(--text); }
  .side-link.on {
    color: var(--text);
    background: rgba(106, 164, 255, 0.1);
    border-left-color: var(--brand);
  }
  .doc-body { max-width: 760px; min-width: 0; overflow-wrap: break-word; }

  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border-soft);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .pn.next { text-align: right; }
  .pn span { color: var(--faint); font-size: 0.8rem; }
  .pn b { color: var(--text); }

  @media (max-width: 860px) {
    .docs { grid-template-columns: 1fr; gap: 20px; }
    .sidebar {
      position: static;
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 14px;
      /* Static above the content here — the viewport cap is the sticky layout's fix only. */
      max-height: none;
      overflow-y: visible;
    }
    .sidebar nav { display: block; }
    .side-h { width: 100%; }
    .side-link { border-left: 0; }
  }
</style>

<!-- prose styling for rendered markdown -->
<script>
  // Glossary popovers (plugins/glossary-links.mjs stamps the terms). One popover element is
  // shared by every term on the page: it opens under the term on hover or keyboard focus,
  // stays open while the pointer is over it (its "defined in" link is meant to be clicked),
  // and closes on leave, blur, or Escape. Touch screens have no hover, and the term is a real
  // link to the glossary, so a tap there simply follows it.
  const terms = document.querySelectorAll<HTMLAnchorElement>('.doc-body a.gloss');
  if (terms.length) {
    const pop = document.createElement('div');
    pop.className = 'gloss-pop';
    pop.id = 'gloss-pop';
    pop.setAttribute('role', 'tooltip');
    pop.hidden = true;
    document.body.appendChild(pop);

    // A definition is plain text with `code` spans; built as nodes, never as HTML.
    const fill = (a: HTMLAnchorElement) => {
      pop.replaceChildren();
      const head = document.createElement('b');
      head.textContent = a.dataset.term ?? '';
      pop.appendChild(head);
      const def = document.createElement('span');
      (a.dataset.def ?? '').split('`').forEach((part, i) => {
        if (!part) return;
        if (i % 2) {
          const code = document.createElement('code');
          code.textContent = part;
          def.appendChild(code);
        } else {
          def.appendChild(document.createTextNode(part));
        }
      });
      pop.appendChild(def);
      if (a.dataset.see) {
        const see = document.createElement('span');
        see.className = 'gloss-see';
        see.append('Defined in ');
        const link = document.createElement('a');
        link.href = a.dataset.see;
        link.textContent = a.dataset.seeTitle ?? a.dataset.see;
        see.appendChild(link);
        pop.appendChild(see);
      }
    };

    let current: HTMLAnchorElement | null = null;
    let closeTimer = 0;
    const place = (a: HTMLAnchorElement) => {
      const r = a.getBoundingClientRect();
      const width = Math.min(340, window.innerWidth - 24);
      pop.style.maxWidth = `${width}px`;
      let left = r.left + window.scrollX;
      if (left + width > window.scrollX + window.innerWidth - 12) {
        left = window.scrollX + window.innerWidth - 12 - width;
      }
      pop.style.left = `${Math.max(12, left)}px`;
      pop.style.top = `${r.bottom + window.scrollY + 8}px`;
    };
    const open = (a: HTMLAnchorElement) => {
      window.clearTimeout(closeTimer);
      if (current !== a) {
        current = a;
        fill(a);
        a.setAttribute('aria-describedby', pop.id);
      }
      pop.hidden = false;
      place(a);
    };
    const close = () => {
      closeTimer = window.setTimeout(() => {
        pop.hidden = true;
        current?.removeAttribute('aria-describedby');
        current = null;
      }, 160);
    };

    terms.forEach((a) => {
      a.addEventListener('mouseenter', () => open(a));
      a.addEventListener('mouseleave', close);
      a.addEventListener('focus', () => open(a));
      a.addEventListener('blur', close);
    });
    pop.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
    pop.addEventListener('mouseleave', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pop.hidden) {
        pop.hidden = true;
        current?.removeAttribute('aria-describedby');
        current = null;
      }
    });
    window.addEventListener('resize', () => { if (current && !pop.hidden) place(current); });
  }
</script>

<style is:global>
  .doc-body h1, .doc-body h2, .doc-body h3 { scroll-margin-top: 84px; }
  .doc-body > h1:first-child, .doc-body > :first-child { margin-top: 0; }
  .doc-body h2 {
    font-size: 1.5rem;
    margin: 44px 0 14px;
    padding-top: 20px;
    border-top: 1px solid var(--border-soft);
  }
  .doc-body h3 { font-size: 1.16rem; margin: 30px 0 10px; }
  .doc-body p, .doc-body li { color: var(--muted); }
  .doc-body strong { color: var(--text); }
  .doc-body a { text-decoration: underline; text-underline-offset: 2px; text-decoration-color: rgba(106,164,255,0.4); }
  /* A tier badge is a pill (global.css), not prose — the docs' link underline would cut it.
     Same for an admonition's permalink, which is a control rather than a reference. */
  .doc-body a.tier-badge,
  .doc-body a.admonition-anchor { text-decoration: none; }
  /* Admonition bodies carry prose, so they inherit the doc-body rhythm; only the box's own
     first/last child margins are collapsed (global.css). */
  .doc-body .admonition-body > p:only-child { margin: 0; }
  .doc-body ul, .doc-body ol { padding-left: 22px; }
  .doc-body li { margin: 6px 0; }
  .doc-body pre {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    box-shadow: var(--shadow);
  }
  /* A wide table scrolls within the column instead of widening the page. `display: block`
     makes the table its own horizontal scroll container on narrow screens. */
  .doc-body table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 18px 0;
    font-size: 0.93rem;
  }
  .doc-body th, .doc-body td {
    text-align: left;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-soft);
  }
  .doc-body th { color: var(--text); font-weight: 650; }
  .doc-body td { color: var(--muted); }
  .doc-body td code { white-space: nowrap; }
  .doc-body blockquote {
    margin: 18px 0;
    padding: 4px 16px;
    border-left: 3px solid var(--brand);
    color: var(--muted);
  }
</style>
