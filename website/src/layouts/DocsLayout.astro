// SPDX-License-Identifier: CC-BY-SA-4.0
import BaseLayout from './BaseLayout.astro';
import SidebarIcon from '../components/SidebarIcon.astro';
import { url } from '../lib/site';
import { contentPages } from '../lib/content';
import { navigation, hubs } from '../lib/content-routes.mjs';

interface Props { title: string; description?: string; route?: string; audience?: string; active?: string }
const { title, description, route = Astro.url.pathname.replace(/\/$/, ''), audience = 'app developer' } = Astro.props;
const active = audience === 'contributor' ? 'contributing' : audience === 'evaluator' ? 'product' : 'docs';
const pages = await contentPages();
const sections = navigation(pages, audience);
const currentSection = sections.find((group) => group.pages.some((p) => p.route === route));
const sequence = currentSection?.sections.find((group) => group.pages.some((p) => p.route === route))?.pages ?? currentSection?.pages ?? [];
const idx = sequence.findIndex((p) => p.route === route);
const prev = idx > 0 ? { href: url(sequence[idx - 1].route), title: sequence[idx - 1].title } : null;
const next = idx >= 0 && idx < sequence.length - 1 ? { href: url(sequence[idx + 1].route), title: sequence[idx + 1].title } : null;
const home = audience === 'contributor' ? '/contributing' : '/docs';

---
<BaseLayout title={title} description={description} active={active}>
  <div class="docs container">
    <aside class="sidebar" data-pagefind-ignore>
      <details class="docs-menu" open>
        <summary class="docs-menu-toggle"><SidebarIcon item="control:browse" /><span class="side-label" title="Browse documentation">Browse documentation</span></summary>
      <nav aria-label={audience === 'contributor' ? 'Contributor documentation' : 'Documentation'}>
        {audience === 'evaluator' ? <>
          <a class="side-link" href={url()}><SidebarIcon item="/" /><span class="side-label" title="Home">Home</span></a>
          <a class="side-link" href={url('features')}><SidebarIcon item="/features" /><span class="side-label" title="Features">Features</span></a>
          <a class="side-link" href={url('examples')}><SidebarIcon item="/examples" /><span class="side-label" title="Examples">Examples</span></a>
          {hubs.filter((h) => h.audience === 'evaluator').map((h) => <a class="side-link" href={url(h.route)} aria-current={h.route === route ? 'page' : undefined}><SidebarIcon item={h.route} /><span class="side-label" title={h.title}>{h.title}</span></a>)}
          <a class="side-link" href={url('docs')}><SidebarIcon item="/docs" /><span class="side-label" title="Documentation">Documentation</span></a>
        </> : <>
          <a class="side-link" href={url(home)} aria-current={route === home ? 'page' : undefined}><SidebarIcon item={home} /><span class="side-label" title={audience === 'contributor' ? 'Contributing home' : 'Start here'}>{audience === 'contributor' ? 'Contributing home' : 'Start here'}</span></a>
          {sections.map((section) => (
            <details open={route === section.route || section.pages.some((p) => p.route === route) || (section.name === 'Reference' && route === '/docs/reference/api')}>
              <summary class="side-h"><SidebarIcon item={section.route} /><span class="side-label" title={section.name}>{section.name}</span></summary>
              <a class="side-link" href={url(section.route)} aria-current={route === section.route ? 'page' : undefined}><SidebarIcon item={section.route} /><span class="side-label" title={`${section.name} index`}>{section.name} index</span></a>
              {section.name === 'Reference' && <a class:list={['side-link', { on: route === '/docs/reference/api' }]} href={url('docs/reference/api')} aria-current={route === '/docs/reference/api' ? 'page' : undefined}><SidebarIcon item="/docs/reference/api" /><span class="side-label" title="Rust API reference">Rust API reference</span></a>}
              {section.sections.length ? section.sections.map((group) => (
                <details class="reference-group" open={group.pages.some((p) => p.route === route)}>
                  <summary class:list={['reference-group-title', { current: group.pages.some((p) => p.route === route) }]}><SidebarIcon item={`group:${group.id}`} /><span class="side-label" title={group.name}>{group.name}</span></summary>
                  <div class="reference-group-pages">
                    {group.pages.map((page) => <a href={url(page.route)}
                      class:list={['side-link', { on: page.route === route }]}
                      aria-current={page.route === route ? 'page' : undefined}
                      title={page.title}><SidebarIcon item={page.route} /><span class="side-label">{page.navTitle ?? page.title}</span></a>)}
                  </div>
                </details>
              )) : section.pages.map((page) => <a href={url(page.route)}
                class:list={['side-link', { on: page.route === route }]}
                aria-current={page.route === route ? 'page' : undefined}
                title={page.title}><SidebarIcon item={page.route} /><span class="side-label">{page.navTitle ?? page.title}</span></a>)}
            </details>
          ))}
          <a class="side-link" href={url(audience === 'contributor' ? 'docs' : 'contributing')}><SidebarIcon item={audience === 'contributor' ? '/docs' : '/contributing'} /><span class="side-label" title={audience === 'contributor' ? 'App documentation' : 'Contributing'}>{audience === 'contributor' ? 'App documentation' : 'Contributing'}</span></a>
        </>}

      </nav>
      </details>
    </aside>

    <article class="doc-body">
      <slot />
      {(prev || next) && (
        <nav class="prevnext" aria-label="Pagination" data-pagefind-ignore>
          {prev ? (
            <a href={prev.href} class="pn"><span>← Previous</span><b>{prev.title}</b></a>
          ) : <span />}
          {next ? (
            <a href={next.href} class="pn next"><span>Next →</span><b>{next.title}</b></a>
          ) : <span />}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: 48px;
    padding-block: 44px 16px;
    align-items: start;
  }
  /* The docs grid supplies its footer spacing, including the sticky sidebar's lower edge. */
  :global(main:has(> .docs) + .footer) { margin-top: 0; }
  .sidebar {
    min-width: 0;
    position: sticky;
    top: 82px;
    align-self: start;
    /* The nav is taller than the viewport, and a sticky box taller than the viewport pins
       immediately and only yields when the container's bottom pushes it — so everything below
       the fold was unreachable until the page was nearly fully scrolled. Capping the box at
       the viewport (minus the 82px header offset and a little breathing room) makes the
       sidebar scroll ITS OWN content under the cursor instead; `overscroll-behavior` keeps a
       wheel at either end from spilling into the page scroll. */
    max-height: calc(100vh - 98px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-right: 6px;
  }
  .sidebar summary { list-style: none; align-items: center; }
  .sidebar summary::-webkit-details-marker { display: none; }
  .sidebar summary::before {
    content: '';
    flex: 0 0 5px;
    width: 5px;
    height: 5px;
    margin: 0 3px;
    align-self: center;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(-45deg);
  }
  .sidebar details[open] > summary::before { transform: rotate(45deg); }
  .sidebar summary.side-h, .reference-group-title { display: flex; gap: 8px; }
  .sidebar nav details { margin-top: 16px; }
  .sidebar nav details.reference-group { margin-top: 4px; }
  .reference-group-title {
    cursor: pointer;
    padding: 10px 6px;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--muted);
    border-radius: 6px;
  }
  .reference-group-title:hover { color: var(--text); background: var(--hover); }
  .reference-group-title.current { color: var(--text); }
  .reference-group-pages { margin: 2px 0 10px 10px; border-left: 1px solid var(--border-soft); }
  .reference-group-pages .side-link { font-size: 0.88rem; padding-block: 7px; }
  .sidebar summary:focus-visible, .sidebar a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .docs-menu-toggle { display: none; font-weight: 600; cursor: pointer; }
  summary.side-h { cursor: pointer; padding: 8px 0; }
  .side-h {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    color: var(--faint);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .side-h:not(:first-child) { margin-top: 20px; }
  .side-link {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border-radius: 9px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    border-left: 2px solid transparent;
  }
  /* Keep row rhythm and icon alignment consistent; the complete text remains in the DOM. */
  .side-label {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .side-link:hover { background: var(--hover); color: var(--text); }
  .side-link.on, .side-link[aria-current="page"] {
    color: var(--text);
    background: rgba(106, 164, 255, 0.1);
    border-left-color: var(--brand);
  }
  .doc-body { max-width: 760px; min-width: 0; overflow-wrap: break-word; }

  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border-soft);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    min-width: 0;
  }
  .pn.next { text-align: right; }
  .pn span { color: var(--faint); font-size: 0.8rem; }
  .pn b { color: var(--text); }

  @media (max-width: 860px) {
    .docs { grid-template-columns: 1fr; gap: 20px; }
    .sidebar {
      position: static;
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
      padding: 14px;
      /* Static above the content here — the viewport cap is the sticky layout's fix only. */
      max-height: none;
      overflow-y: visible;
    }
    .sidebar nav { display: block; }
    .docs-menu-toggle { display: flex; gap: 8px; }
    .docs-menu[open] > .docs-menu-toggle { margin-bottom: 16px; }
    .side-h { width: 100%; }
    .side-link { border-left: 0; }
  }
</style>

<!-- prose styling for rendered markdown -->
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.docs-menu');
  const narrow = window.matchMedia('(max-width: 860px)');
  const sizeMenu = () => { if (menu) menu.open = !narrow.matches; };
  sizeMenu();
  narrow.addEventListener('change', sizeMenu);

  // Glossary popovers (plugins/glossary-links.mjs stamps the terms). One popover element is
  // shared by every term on the page: it opens under the term on hover or keyboard focus,
  // stays open while the pointer is over it (its "defined in" link is meant to be clicked),
  // and closes on leave, blur, or Escape. Touch screens have no hover, and the term is a real
  // link to the glossary, so a tap there simply follows it.
  const terms = document.querySelectorAll<HTMLAnchorElement>('.doc-body a.gloss');
  if (terms.length) {
    const pop = document.createElement('div');
    pop.className = 'gloss-pop';
    pop.id = 'gloss-pop';
    pop.setAttribute('role', 'tooltip');
    pop.hidden = true;
    document.body.appendChild(pop);

    // A definition is plain text with `code` spans; built as nodes, never as HTML.
    const fill = (a: HTMLAnchorElement) => {
      pop.replaceChildren();
      const head = document.createElement('b');
      head.textContent = a.dataset.term ?? '';
      pop.appendChild(head);
      const def = document.createElement('span');
      (a.dataset.def ?? '').split('`').forEach((part, i) => {
        if (!part) return;
        if (i % 2) {
          const code = document.createElement('code');
          code.textContent = part;
          def.appendChild(code);
        } else {
          def.appendChild(document.createTextNode(part));
        }
      });
      pop.appendChild(def);
      if (a.dataset.see) {
        const see = document.createElement('span');
        see.className = 'gloss-see';
        see.append('Defined in ');
        const link = document.createElement('a');
        link.href = a.dataset.see;
        link.textContent = a.dataset.seeTitle ?? a.dataset.see;
        see.appendChild(link);
        pop.appendChild(see);
      }
    };

    let current: HTMLAnchorElement | null = null;
    let closeTimer = 0;
    const place = (a: HTMLAnchorElement) => {
      const r = a.getBoundingClientRect();
      const width = Math.min(340, window.innerWidth - 24);
      pop.style.maxWidth = `${width}px`;
      let left = r.left + window.scrollX;
      if (left + width > window.scrollX + window.innerWidth - 12) {
        left = window.scrollX + window.innerWidth - 12 - width;
      }
      pop.style.left = `${Math.max(12, left)}px`;
      pop.style.top = `${r.bottom + window.scrollY + 8}px`;
    };
    const open = (a: HTMLAnchorElement) => {
      window.clearTimeout(closeTimer);
      if (current !== a) {
        current = a;
        fill(a);
        a.setAttribute('aria-describedby', pop.id);
      }
      pop.hidden = false;
      place(a);
    };
    const close = () => {
      closeTimer = window.setTimeout(() => {
        pop.hidden = true;
        current?.removeAttribute('aria-describedby');
        current = null;
      }, 160);
    };

    terms.forEach((a) => {
      a.addEventListener('mouseenter', () => open(a));
      a.addEventListener('mouseleave', close);
      a.addEventListener('focus', () => open(a));
      a.addEventListener('blur', close);
    });
    pop.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
    pop.addEventListener('mouseleave', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pop.hidden) {
        pop.hidden = true;
        current?.removeAttribute('aria-describedby');
        current = null;
      }
    });
    window.addEventListener('resize', () => { if (current && !pop.hidden) place(current); });
  }
</script>

<style is:global>
  .doc-body h1, .doc-body h2, .doc-body h3 { scroll-margin-top: 84px; }
  .doc-body > h1:first-child, .doc-body > :first-child { margin-top: 0; }
  .doc-body h2 {
    font-size: 1.5rem;
    margin: 44px 0 14px;
    padding-top: 20px;
    border-top: 1px solid var(--border-soft);
  }
  .doc-body h3 { font-size: 1.16rem; margin: 30px 0 10px; }
  .doc-body p, .doc-body li { color: var(--muted); }
  .doc-body strong { color: var(--text); }
  .doc-body a { text-decoration: underline; text-underline-offset: 2px; text-decoration-color: rgba(106,164,255,0.4); }
  /* A tier badge is a pill (global.css), not prose — the docs' link underline would cut it.
     Same for an admonition's permalink, which is a control rather than a reference. */
  .doc-body a.tier-badge,
  .doc-body a.admonition-anchor { text-decoration: none; }
  /* Admonition bodies carry prose, so they inherit the doc-body rhythm; only the box's own
     first/last child margins are collapsed (global.css). */
  .doc-body .admonition-body > p:only-child { margin: 0; }
  .doc-body ul, .doc-body ol { padding-left: 22px; }
  .doc-body li { margin: 6px 0; }
  .doc-body pre {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    box-shadow: var(--shadow);
  }
  /* A wide table scrolls within the column instead of widening the page. `display: block`
     makes the table its own horizontal scroll container on narrow screens. */
  .doc-body table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 18px 0;
    font-size: 0.93rem;
  }
  .doc-body th, .doc-body td {
    text-align: left;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-soft);
  }
  .doc-body th { color: var(--text); font-weight: 650; }
  .doc-body td { color: var(--muted); }
  .doc-body td code { white-space: nowrap; }
  .doc-body blockquote {
    margin: 18px 0;
    padding: 4px 16px;
    border-left: 3px solid var(--brand);
    color: var(--muted);
  }
</style>
