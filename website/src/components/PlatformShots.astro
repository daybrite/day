---
// Copyright © The Daybrite Project
// SPDX-License-Identifier: CC-BY-SA-4.0
// A small strip of Showcase captures for one platform-toolkit page, linked into the gallery.
//
// It reads the SAME `gallery-manifest.json` the gallery pages do (the published indexes, fetched
// by integrations/gallery.mjs), and renders only shots the app actually captured for this
// platform: a screen it has no capture of yields nothing rather than a broken image. That keeps
// these pages accurate on a build where an app's site was unreachable.
import manifest from '../data/gallery-manifest.json';
import { url } from '../lib/site';

interface Props {
  /** Platform id, e.g. `linux-gtk` — a gallery column id (src/lib/platforms.mjs). */
  platform: string;
  /** Shot ids, in display order (the ids the Showcase's dayscript captures under). */
  shots: string[];
  /** Preferred theme; falls back to whatever was captured. */
  variant?: string;
}

const { platform, shots, variant = 'light' } = Astro.props;

// The Showcase is the app these platform pages document.
const app = manifest.apps.find((a) => a.id === 'Day-Showcase');
const preferred = [`${variant}|en`, `${variant}|default`, `default|en`];

type Tile = { shot: string; label: string; src: string; width?: number; height?: number };

const tiles: Tile[] = [];
for (const id of shots) {
  const shot = app?.shots.find((s) => s.id === id);
  const tile = shot?.byColumn.find((t) => t.column === platform);
  if (!shot || !tile) continue;
  const captures = tile.captures as Record<
    string,
    { src: string; width?: number; height?: number }
  >;
  const img =
    preferred.map((k) => captures[k]).find(Boolean) ?? Object.values(captures)[0];
  if (!img) continue;
  tiles.push({ shot: id, label: shot.label, src: img.src, width: img.width, height: img.height });
}
---

{tiles.length > 0 && (
  <div class="shots" data-pagefind-ignore>
    {tiles.map((t) => (
      <a class="shot" href={url(`gallery/Day-Showcase#${t.shot}`)} title={`${t.label} — see every platform in the gallery`}>
        <img src={t.src} alt={`${t.label}, captured on ${platform}`} width={t.width} height={t.height} loading="lazy" decoding="async" />
        <span>{t.label}</span>
      </a>
    ))}
  </div>
)}

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    margin: 22px 0 26px;
  }
  .shot {
    display: flex;
    flex-direction: column;
    gap: 7px;
    text-decoration: none;
    color: inherit;
  }
  .shot img {
    width: 100%;
    height: auto;
    /* Tall phone captures and wide desktop ones share a row; cap the tall ones so the strip
       stays a strip. object-position pins the crop to the top, where the content is. */
    max-height: 260px;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .shot span {
    font-size: 0.82rem;
    color: var(--fg-dim);
  }
  .shot:hover img {
    border-color: var(--brand);
  }
  .shot:hover span {
    color: var(--fg);
  }
</style>
