import CodeSample from './CodeSample.astro';
import { url } from '../lib/site';
import { tutorialRecipe } from '../lib/tutorial-data';
import { lessonFiles } from '../lib/tutorials.mjs';

// Display the tutorial's exact UI function. The build integration checks its AppKit capture
// against the recipe and image hashes on local and publication builds. Change the recipe
// and recapture the app together; do not maintain a second version of this Rust example.
const lessonCount = tutorialRecipe.lessons.findIndex(lesson => lesson.id === 'state') + 1;
const source = lessonFiles(tutorialRecipe, 'macos', lessonCount).get('src/lib.rs');
const start = source?.indexOf('pub fn root()');
if (!source || start === undefined || start < 0) throw new Error('Missing tutorial counter UI function.');
const code = source.slice(start).trim();
---
<div class="rust-example">
  <div class="rust-example-source">
    <CodeSample code={code} title="src/lib.rs · UI function" />
    <p class="example-note">The label follows <code>count</code>; the button updates it. <code>res::str</code> provides the translated messages.</p>
  </div>
  <figure class="rust-example-result">
    <img src={url('images/tutorial/counter-two.png')} width="800" height="640" loading="lazy" decoding="async"
      alt="The Session counter on macOS, showing Count: 2 and a native Add one button." />
    <figcaption>After two clicks · macOS / AppKit</figcaption>
  </figure>
</div>
<p class="example-links"><a href={url('docs/tutorials/state')}>Build this counter →</a><a href={url('docs/reference/api-tour')}>Explore the Rust API →</a></p>
<style>
  .rust-example { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .rust-example-source { min-width: 0; }
  .rust-example-source :global(pre) { font-size: .75rem; }
  .rust-example-result { margin: 0; min-width: 0; }
  .rust-example-result img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .example-note, figcaption { color: var(--muted); font-size: .85rem; line-height: 1.6; margin: 14px 0 0; }
  .example-links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 0; }
  @media (max-width: 880px) { .rust-example { grid-template-columns: minmax(0, 1fr); } .rust-example-result { width: 100%; max-width: 420px; } }
</style>
