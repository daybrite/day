// SPDX-License-Identifier: CC-BY-SA-4.0
import CodeSample from './CodeSample.astro';
import { url } from '../lib/site';
import demo from '../data/live-demo.json';

// The build integration compiles this app before Astro reads the component. Display its
// actual root function, including its shared signal and generated localization accessors.
const code = demo.code;
// Match the snippet (20px lines plus padding and borders), with room for the app's controls.
const demoHeight = `${Math.max(240, code.split('\n').length * 20 + 20)}px`;
---
<div class="rust-example" style={{ '--demo-height': demoHeight }}>
  <div class="rust-example-source">
    <CodeSample code={code} chrome={false} />
  </div>
  <figure class="rust-example-result">
    <div class="demo-frame" data-live-demo>
      <p class="demo-status" role="status">Loading live demo…</p>
      <iframe src={url(demo.src)} loading="lazy" title="Live Day app: controls sharing one signal"></iframe>
    </div>
    <noscript><p>Enable JavaScript to try the live demo.</p></noscript>
  </figure>
</div>
<p class="example-links"><a href="https://github.com/daybrite/day/tree/main/apps/website-controls">View the app’s source →</a><a href={url('docs/tutorials/state')}>Learn about signals →</a><a href={url('docs/reference/api-tour')}>Explore the Rust API →</a></p>
<script>
  // The browser handles lazy loading. These messages only synchronize appearance;
  // changing theme must not reload the iframe or discard the visitor's edits.
  for (const host of document.querySelectorAll<HTMLElement>('[data-live-demo]')) {
    const frame = host.querySelector<HTMLIFrameElement>('iframe')!;
    const status = host.querySelector<HTMLElement>('.demo-status')!;
    const theme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const sendTheme = () => {
      if (!frame?.contentWindow) return;
      // Use the parent's function realm: WebKit otherwise reports the iframe itself as
      // event.source when a MutationObserver calls the cross-window method.
      window.postMessage.call(frame.contentWindow, { type: 'day-demo-theme', theme: theme() }, location.origin);
    };
    let timeout: ReturnType<typeof setTimeout>;
    window.addEventListener('message', event => {
      if (!frame || event.source !== frame.contentWindow || event.origin !== location.origin) return;
      if (event.data?.type !== 'day-demo-ready') return;
      clearTimeout(timeout);
      host.dataset.ready = 'true';
      status.hidden = true;
      sendTheme();
    });
    new MutationObserver(sendTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    // Do not time out while the browser is still deferring an offscreen iframe.
    frame.addEventListener('load', () => {
      if (host.dataset.ready === 'true') return;
      timeout = setTimeout(() => {
        status.textContent = 'The demo could not load. Reload the page to try again.';
      }, 30000);
    }, { once: true });
  }
</script>
<style>
  /* CSS alone sets a 2:1 ratio; long source lines scroll inside their column. */
  .rust-example { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 24px; align-items: center; }
  .rust-example-source { min-width: 0; }
  /* Line height and padding also determine --demo-height above. */
  .rust-example-source :global(pre) { min-height: calc(var(--demo-height) - 2px); font-size: .8125rem; line-height: 20px; padding: 9px 20px; }
  /* Narrow spaces visually while preserving the source's indentation when copied. */
  .rust-example-source :global(code) { word-spacing: -.15em; }
  .rust-example-result { margin: 0; min-width: 0; }
  .demo-frame { position: relative; height: var(--demo-height); overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .demo-frame :global(iframe) { display: block; width: 100%; height: 100%; border: 0; opacity: 0; }
  .demo-frame[data-ready=true] :global(iframe) { opacity: 1; }
  .demo-status { position: absolute; inset: 0; display: grid; place-content: center; margin: 0; padding: 24px; color: var(--muted); font-size: .85rem; }
  .demo-status[hidden] { display: none; }
  .example-links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 0; }
  @media (max-width: 700px) {
    .rust-example { grid-template-columns: minmax(0, 1fr); }
    .rust-example-result { width: 100%; max-width: 420px; }
  }
</style>
