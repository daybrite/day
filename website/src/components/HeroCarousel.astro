---
// Copyright © The Daybrite Project
// SPDX-License-Identifier: CC-BY-SA-4.0
// Auto-advancing carousel of reviewed gallery screenshots from Day apps,
// cross-fading, with the platform name + toolkit animating in below each image. The pool is built
// (and every image verified non-blank) at build time by scripts/hero-shots.mjs. Each slide carries
// its available captures; reviewed dark-only selections complement apps without dark captures.
// Only verified images for the current theme appear in its rotation.
import { res } from '../generated/strings.mjs';
import { url } from '../lib/site';
import DeviceShell from './DeviceShell.astro';
import PlatformIcon from './PlatformIcon.astro';
import shotsData from '../data/hero-shots.json';

const shots: {
  src?: string;
  srcDark?: string;
  shot?: string;
  app: string;
  label: string;
  gallery: string;
  framed: boolean;
  width?: number;
  height?: number;
  widthDark?: number;
  heightDark?: number;
  os: string;
  toolkit: string;
  accent: string;
  alt: string;
}[] = shotsData.shots ?? [];

// The caption's mark changes with the slide, and the slide order is decided in the browser, so
// every platform in the pool is rendered once here (hidden) for the controller to copy from.
const initial = Math.max(0, shots.findIndex(s => s.src));
const accents = [...new Set(shots.map((s) => s.accent))];
---
{shots.length > 0 && (
  <figure class="hero-carousel" data-hero-carousel aria-roledescription={res.str.carousel()} aria-label={res.str.hero_label()}>
    {/* The frame links to the gallery, anchored at the row for the screen currently showing —
        the controller retargets the href on every image change. */}
    <a class="hc-link" data-hc-link href={url(shots[initial].gallery)} aria-label={res.str.see_gallery().replace('{app}', shots[initial].label)}>
      <div class="hc-stage">
        <div class="hc-glow" aria-hidden="true" data-hc-glow></div>
        {shots.map((s, i) => (
          <div aria-hidden={i !== initial} class:list={['hc-slide', { 'is-active': i === initial }]}>
            {/* Use the gallery's device shell unless the capture already includes window chrome. */}
            {s.framed ? <div class="hc-capture">
              <img class="hc-img" src={i === initial && s.src ? url(s.src) : undefined} alt={s.alt} width={s.width} height={s.height}
                decoding="async" loading="eager" fetchpriority={i === initial ? 'high' : 'low'}
                data-src-light={s.src ? url(s.src) : undefined} data-src-dark={s.srcDark ? url(s.srcDark) : undefined}
                data-width-light={s.width} data-height-light={s.height}
                data-width-dark={s.widthDark} data-height-dark={s.heightDark}
                data-shot={s.shot} data-gallery={url(s.gallery)} data-app={s.label}
                data-os={s.os} data-toolkit={s.toolkit} data-accent={s.accent} />
            </div> : <DeviceShell platform={s.accent} title={s.label} w={s.width ?? s.widthDark} h={s.height ?? s.heightDark}>
              <img
                class="hc-img"
                src={i === initial && s.src ? url(s.src) : undefined}
                alt={s.alt}
                width={s.width ?? 1000}
                height={s.height ?? 750}
                decoding="async"
                loading="eager" fetchpriority={i === initial ? 'high' : 'low'}
                data-src-light={s.src ? url(s.src) : undefined}
                data-src-dark={s.srcDark ? url(s.srcDark) : undefined}
                data-width-light={s.width} data-height-light={s.height}
                data-width-dark={s.widthDark} data-height-dark={s.heightDark}
                data-shot={s.shot}
                data-gallery={url(s.gallery)}
                data-app={s.label}
                data-os={s.os}
                data-toolkit={s.toolkit}
                data-accent={s.accent}
              />
            </DeviceShell>}
          </div>
        ))}
      </div>
    </a>
    {/* The progress dashes are controls, not decoration: hovering one jumps straight to that
        slide and holds it, and following one opens the same gallery row the frame links to.
        Their hrefs and labels are per-position, so the controller fills them in once the
        shuffled order for this visit is known. */}
    <div class="hc-track" data-hc-track>
      {shots.map(s => (
        <a class="hc-seg" data-hc-seg hidden={!s.src} href={url(s.gallery)} aria-label={res.str.show_platform().replace('{app}', s.label).replace('{os}', s.os).replace('{toolkit}', s.toolkit)}><span class="hc-bar"><i></i></span></a>
      ))}
    </div>
    <div class="hc-icons" data-hc-icons aria-hidden="true">
      {accents.map((a) => <span data-icon-for={a}><PlatformIcon id={a} /></span>)}
    </div>
    <figcaption class="hc-caption" data-hc-caption>
      <span class="hc-app" data-hc-app>{shots[initial].label}</span>
      <span class="hc-plat">
        <span class="hc-icon" data-hc-icon aria-hidden="true"></span>
        <b class="hc-os" data-hc-os></b>
        <span class="hc-toolkit" data-hc-toolkit></span>
      </span>
    </figcaption>
  </figure>
)}

<style>
  .hero-carousel[hidden], .hc-seg[hidden] { display: none; }
  :global(html[data-theme=dark]) .hero-carousel:not([data-hero-ready]) .hc-slide { opacity: 0; transition: none; }
  .hero-carousel { margin: 0; display: flex; flex-direction: column; gap: 16px; }

  .hc-link { display: block; border-radius: var(--radius-lg); }
  .hc-link:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }

  /* No matte: the stage is an invisible box that only reserves height, so what the visitor sees
     is the device itself — bare screenshot inside its window chrome or bezel, floating on the
     page background. The aspect ratio keeps the hero from resizing as portrait phones and
     landscape desktops take turns. */
  .hc-stage {
    position: relative;
    /* An explicit height, not an aspect ratio, because the shells size themselves from the
       PICTURE: a percentage max-height cannot resolve against a shell whose own height is what
       the picture decides, so the screen's height budget is handed down in absolute units. */
    --hc-h: clamp(300px, 34vw, 520px);
    /* The shell's height budget, the same handshake the gallery's .frame makes: DeviceShell
       derives the window's width from this and the capture's aspect, which is what puts the
       title bar exactly edge-to-edge with the picture (and what lets the bar scale with it). */
    --shell-h: var(--hc-h);
    height: var(--hc-h);
  }
  /* Accent glow tinted by the active platform (var set from JS) — a pool of light UNDER the
     device now that there is no panel to tint. */
  .hc-glow {
    position: absolute; inset: -6% -4%;
    background: radial-gradient(58% 46% at 50% 50%, var(--hc-accent, transparent), transparent 70%);
    opacity: 0.22;
    transition: background 0.6s ease;
    pointer-events: none;
  }
  .hc-slide {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .hc-capture { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .hc-capture img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 26px 60px -24px rgba(0, 0, 0, .45); }
  /* Tablet targets have no synthetic shell. Constrain their bare image in both dimensions,
     just as a framed capture is constrained, without changing phone or window sizing. */
  .hc-slide > .hc-img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 26px 60px -24px rgba(0, 0, 0, .45); }
  .hc-app { color: var(--muted); font-size: .85rem; }
  .hc-slide.is-active { opacity: 1; transform: scale(1); }
  /* Window shells size themselves from --shell-h + the capture's aspect (see .hc-stage), so
     they need no height cap here. Bezels still do: they have no data-fit path. */
  .hc-slide :global(.sh-dev > *) { max-height: calc(var(--hc-h) - 18px); }

  /* The shells carry a tile-sized shadow in the gallery grid; standing alone at hero size they
     need a deeper one to lift off the page. */
  .hc-slide :global(.sh-win) { box-shadow: 0 26px 60px -24px rgba(0, 0, 0, 0.55); }
  .hc-slide :global(.sh-dev) {
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.08),
      0 26px 60px -24px rgba(0, 0, 0, 0.55);
  }

  /* Story-style segmented progress / index. Each dash is a link, so it needs a hit area a
     pointer can actually catch: the anchor is padded to 25px tall and the track pulls that
     padding back out with a negative margin, leaving the layout exactly where it was. */
  .hc-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24px, 1fr));
    column-gap: 4px;
    padding: 0 2px; margin: -11px 0;
  }
  .hc-seg {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 11px 0;
    cursor: pointer;
  }
  .hc-seg:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 3px; }
  .hc-bar {
    flex: 1; height: 3px; border-radius: 2px;
    background: var(--border);
    overflow: hidden;
    transition: background 0.15s ease;
  }
  /* Hovering a dash previews its slide; lift the unfilled track so the target reads as live. */
  .hc-seg:hover .hc-bar { background: color-mix(in srgb, var(--hc-accent, var(--brand)) 35%, var(--border)); }
  .hc-seg i {
    display: block; height: 100%; width: 100%;
    background: var(--hc-accent, var(--brand));
    transform: scaleX(0); transform-origin: left;
  }
  .hc-seg.is-past i { transform: scaleX(1); opacity: 0.5; }
  .hc-seg.is-active i { animation: hc-fill var(--hc-interval, 3400ms) linear forwards; }
  @keyframes hc-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .hc-caption { display: flex; flex-direction: column; gap: 3px; min-height: 40px; }
  .hc-plat { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  /* The platform mark, wearing the same accent as the OS name beside it. */
  /* The mark sits ON the text baseline, like a capital letter: an SVG's baseline is its bottom
     margin edge, so letting it take part in the row's baseline alignment (rather than centering it
     against the line box) puts its foot exactly where "iOS" and "UIKit" put theirs. */
  .hc-icon { display: inline-flex; color: var(--hc-accent, var(--text)); }
  .hc-icon :global(.pf-icon) { width: 1.35rem; height: 1.35rem; }
  .hc-icons { display: none; }
  .hc-os {
    font-size: 1.35rem; font-weight: 800; line-height: 1.1;
    color: var(--hc-accent, var(--text));
  }
  :global(html[data-theme=light]) .hc-os { color: color-mix(in srgb, var(--hc-accent, var(--text)) 70%, var(--text)); }
  .hc-toolkit { color: var(--muted); font-size: 0.95rem; font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    .hc-slide { transition: opacity 0.2s linear; transform: none; }
    .hc-slide.is-active { transform: none; }
    .hc-seg.is-active i { animation: none; transform: scaleX(1); }
  }
</style>

<script>
  import { res } from '../generated/strings.mjs';
  import { heroCapture } from '../lib/hero-theme.mjs';

  // Carousel controller: shuffle the verified pool (so each visit differs), cross-fade the images,
  // and animate the platform caption in sync. Pauses on hover / when the tab is hidden.
  function initHeroCarousel() {
    const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
    if (!root || root.hasAttribute('data-hero-initialized')) return;
    root.setAttribute('data-hero-initialized', '');

    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>('.hc-img'));
    // The image carries the data; the slide (image + its shell) is what cross-fades.
    const slides = imgs.map((im) => im.closest<HTMLElement>('.hc-slide')!);
    const segs = Array.from(root.querySelectorAll<HTMLElement>('.hc-seg'));
    const link = root.querySelector<HTMLAnchorElement>('[data-hc-link]');
    const glow = root.querySelector<HTMLElement>('[data-hc-glow]');
    const caption = root.querySelector<HTMLElement>('[data-hc-caption]');
    const osEl = root.querySelector<HTMLElement>('[data-hc-os]');
    const iconEl = root.querySelector<HTMLElement>('[data-hc-icon]');
    const tkEl = root.querySelector<HTMLElement>('[data-hc-toolkit]');
    const appEl = root.querySelector<HTMLElement>('[data-hc-app]');
    if (imgs.length === 0) return;

    const INTERVAL = 3400;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Fisher–Yates shuffle of the display order.
    let order = imgs.map((_, i) => i);
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    // The pool holds several shots per platform, so a plain shuffle can land the same
    // platform twice in a row. Repair: for each position that repeats its predecessor's
    // platform, swap with any other position where BOTH elements fit their new neighbors;
    // then mend the loop join (last → first counts as adjacent) the same way. With the real
    // pool (≥3 platforms) this converged in 0 of 50k simulated shuffles' failures; degenerate
    // pools (≤2 platforms) stay best-effort rather than looping.
    const plat = (idx: number) => imgs[idx].dataset.accent ?? '';
    for (let i = 1; i < order.length; i++) {
      if (plat(order[i]) !== plat(order[i - 1])) continue;
      for (let j = 1; j < order.length; j++) {
        if (j === i) continue;
        const fitsAtI =
          plat(order[j]) !== plat(order[i - 1]) &&
          (i + 1 >= order.length || plat(order[j]) !== plat(order[i + 1]));
        const fitsAtJ =
          plat(order[i]) !== plat(order[j - 1]) &&
          (j + 1 >= order.length || plat(order[i]) !== plat(order[j + 1]));
        if (fitsAtI && fitsAtJ) {
          [order[i], order[j]] = [order[j], order[i]];
          break;
        }
      }
    }
    const last = order.length - 1;
    if (last >= 2 && plat(order[0]) === plat(order[last])) {
      for (let k = 1; k < last; k++) {
        const fitsThere =
          plat(order[k]) !== plat(order[last - 1]) && plat(order[k]) !== plat(order[0]);
        const fitsHere =
          plat(order[last]) !== plat(order[k - 1]) && plat(order[last]) !== plat(order[k + 1]);
        if (fitsThere && fitsHere) {
          [order[k], order[last]] = [order[last], order[k]];
          break;
        }
      }
    }

    // The server-rendered image is already prioritized; do not discard that work at startup.
    // Rotate the ring to preserve the platform spacing established above.
    const first = order.indexOf(Math.max(0, imgs.findIndex(img => img.dataset.srcLight)));
    order = [...order.slice(first), ...order.slice(0, first)];
    const fullOrder = [...order];
    const captures = imgs.map(img => ({
      src: img.dataset.srcLight, srcDark: img.dataset.srcDark,
      width: Number(img.dataset.widthLight), height: Number(img.dataset.heightLight),
      widthDark: Number(img.dataset.widthDark), heightDark: Number(img.dataset.heightDark),
    }));
    let renderRevision = 0;
    let theme: 'light' | 'dark' = 'light';
    const decoded = new Map<string, Promise<boolean>>();
    function preload(src: string, priority: 'high' | 'low' = 'low') {
      if (!decoded.has(src)) {
        const image = new Image();
        image.fetchPriority = priority;
        image.src = src;
        decoded.set(src, image.decode().then(() => true, () => { decoded.delete(src); return false; }));
      }
      return decoded.get(src)!;
    }

    let pos = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    async function render(p: number) {
      const request = ++renderRevision;
      const idx = order[p];
      if (idx === undefined) return;
      root!.setAttribute('aria-busy', 'true');
      const capture = heroCapture(captures[idx], theme)!;
      const loaded = await preload(capture.src!, 'high');
      if (request !== renderRevision) return;
      if (!loaded) {
        order = order.filter(i => i !== idx);
        updateSegments();
        root!.hidden = !order.length;
        root!.setAttribute('aria-busy', 'false');
        if (order.length) { pos = p % order.length; void render(pos); }
        return;
      }
      imgs[idx].src = capture.src!;
      imgs[idx].width = capture.width!;
      imgs[idx].height = capture.height!;
      const shell = imgs[idx].closest<HTMLElement>('.sh-win');
      shell?.toggleAttribute('data-dark', theme === 'dark');
      shell?.style.setProperty('--ar', String(capture.width! / capture.height!));
      root!.dataset.heroTheme = theme;
      root!.setAttribute('data-hero-ready', '');
      root!.setAttribute('aria-busy', 'false');
      const img = imgs[idx];
      const accent = `var(--pf-${img.dataset.accent ?? 'macos'})`;
      root!.style.setProperty('--hc-accent', accent);
      root!.style.setProperty('--hc-interval', `${INTERVAL}ms`);
      if (glow) glow.style.setProperty('--hc-accent', accent);
      // The headline's "Day:" wears the active platform's accent too (index.astro .hero-day
      // transitions `color`, so it glides between platforms in step with the cross-fade).
      root!.closest<HTMLElement>('.hero')?.style.setProperty('--hero-accent', accent);

      slides.forEach((sl, i) => { sl.classList.toggle('is-active', i === idx); sl.setAttribute('aria-hidden', String(i !== idx)); });

      // Progress segments track position within the shuffled order.
      segs.forEach((seg, i) => {
        seg.classList.toggle('is-active', i === p);
        seg.classList.toggle('is-past', i < p);
      });

      // Each screenshot links to its app's exact gallery row.
      if (link && img.dataset.gallery) {
        link.href = img.dataset.gallery;
        link.setAttribute('aria-label', res.str.see_gallery().replace('{app}', img.dataset.app ?? ''));
      }
      if (appEl) appEl.textContent = img.dataset.app ?? '';

      if (iconEl) {
        const mark = root!.querySelector(`[data-icon-for="${img.dataset.accent}"]`);
        iconEl.innerHTML = mark ? mark.innerHTML : '';
      }
      if (osEl) osEl.textContent = img.dataset.os ?? '';
      if (tkEl) tkEl.textContent = img.dataset.toolkit ?? '';
      // WAAPI restarts without forcing layout and respects changes to motion preferences.
      caption?.getAnimations({ subtree: true }).forEach(animation => animation.cancel());
      if (!reduce.matches) caption?.animate([
        { opacity: 0, transform: 'translateY(8px)' },
        { opacity: 1, transform: 'translateY(0)' },
      ], { duration: 500, easing: 'ease' });
      // Only the next capture is decoded speculatively; unrelated images cannot delay this one.
      const next = order[(p + 1) % order.length];
      if (next !== idx) void preload(heroCapture(captures[next], theme)!.src!);
      start();
    }

    function advance() {
      stop();
      pos = (pos + 1) % order.length;
      render(pos);
    }
    function start() {
      if (reduce.matches || timer || order.length < 2 || document.hidden || root!.matches(':hover, :focus-within') || root!.getAttribute('aria-busy') === 'true') return;
      timer = setInterval(advance, INTERVAL);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = undefined; }
    }

    // Clicking the frame follows its link to the gallery row for the current screen (no
    // click-to-advance — hover already pauses, and the timer keeps cycling otherwise).
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', event => {
      if (!root.contains(event.relatedTarget as Node)) queueMicrotask(start);
    });
    reduce.addEventListener('change', () => {
      caption?.getAnimations({ subtree: true }).forEach(animation => animation.cancel());
      reduce.matches ? stop() : start();
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // The visible dashes follow the current theme's rotation. Their event handlers read
    // the current order so switching themes cannot leave a link attached to the wrong app.
    function updateSegments() {
      segs.forEach((seg, i) => {
        seg.hidden = i >= order.length;
        if (seg.hidden) return;
        const img = imgs[order[i]];
        if (seg instanceof HTMLAnchorElement && img.dataset.gallery) seg.href = img.dataset.gallery;
        seg.setAttribute('aria-label', res.str.show_platform().replace('{app}', img.dataset.app ?? '').replace('{os}', img.dataset.os ?? '').replace('{toolkit}', img.dataset.toolkit ?? ''));
      });
    }
    segs.forEach((seg, i) => {
      const jump = () => {
        if (pos === i || i >= order.length) return;
        pos = i;
        render(i);
      };
      // Hold explicitly rather than leaning on the carousel-wide hover pause: the dash is the
      // thing being pointed at, so it is the thing that should stop the timer. Cycling resumes
      // once the pointer is off the carousel entirely, which is what the root's handler decides.
      seg.addEventListener('mouseenter', () => {
        stop();
        jump();
      });
      seg.addEventListener('mouseleave', () => {
        if (!root!.matches(':hover')) start();
      });
      // Keyboard parity: tabbing across the dashes previews each one too.
      seg.addEventListener('focus', jump);
    });

    function applyTheme() {
      const previous = order[pos];
      stop();
      ++renderRevision;
      theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      order = fullOrder.filter(i => heroCapture(captures[i], theme));
      root!.hidden = order.length === 0;
      root!.removeAttribute('data-hero-ready');
      root!.setAttribute('aria-busy', 'false');
      updateSegments();
      pos = Math.max(0, order.indexOf(previous));
      if (order.length) void render(pos);
    }
    const observer = new MutationObserver(() => {
      if (root!.isConnected) applyTheme();
      else observer.disconnect();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    applyTheme();
  }

  // This site uses full document navigation.
  initHeroCarousel();
</script>
