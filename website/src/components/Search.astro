import { res } from '../generated/strings.mjs';
import { url } from '../lib/site';
// Pagefind indexes the built site (`pagefind --site dist` in the build script) into /pagefind/.
// Dev serves the latest built index through integrations/dev-search.mjs.
const pagefindJs = url('pagefind/pagefind-ui.js');
const pagefindCss = url('pagefind/pagefind-ui.css');
---
<button type="button" class="search-trigger" data-search-open aria-label={res.str.search()} aria-keyshortcuts="Meta+K Control+K">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
  </svg>
  <span class="st-text">{res.str.search()}</span>
</button>

<dialog class="search-modal" data-search-dialog aria-label={res.str.search_title()} closedby="any" data-pagefind-js={pagefindJs} data-pagefind-css={pagefindCss} data-pagefind-ignore>
  <form method="dialog" class="search-close"><button autofocus aria-label={res.str.close()}>{res.str.close()}</button></form>
  <p role="status" data-search-status hidden></p>
  <button type="button" data-search-retry hidden>{res.str.retry()}</button>
  <div class="search-panel">
    <div id="pagefind-search" data-search-mount></div>
  </div>
</dialog>

<script>
  import { initSearch } from '../lib/search-client.mjs';
  initSearch();
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px 0 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--hover);
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .search-trigger:hover { color: var(--text); border-color: var(--brand); }
  .search-trigger svg { width: 15px; height: 15px; }

  .search-modal {
    /* Pagefind UI theming — inherited by the widget mounted inside. */
    --pagefind-ui-primary: var(--brand);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: var(--font);

    width: min(640px, calc(100vw - 32px));
    max-height: min(70vh, 640px);
    margin: 12vh auto auto;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: auto;
  }
  .search-modal::backdrop {
    background: rgba(4, 7, 14, 0.55);
    backdrop-filter: blur(4px);
  }
  .search-close { display: flex; justify-content: flex-end; margin-bottom: 12px; }
  .search-unavailable { color: var(--muted); font-size: 0.92rem; margin: 6px 2px; }

  @media (max-width: 620px) {
    .search-trigger .st-text { display: none; }
    .search-trigger { padding: 0 9px; }
  }
</style>
