// SPDX-License-Identifier: CC-BY-SA-4.0
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, isDraftPost, postDate } from '../../lib/blog';
import { url } from '../../lib/site';
import { res } from '../../generated/strings.mjs';

export async function getStaticPaths() {
  return (await blogPosts(import.meta.env.DEV)).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const draft = isDraftPost(post);
---
<BaseLayout title={post.data.title} description={post.data.description} active="blog" noindex={draft}>
  <article class="section">
    <div class="container blog-post">
      <a class="back" href={url('blog')}><span aria-hidden="true">← </span>{res.str.blog_back()}</a>
      <header>
        {draft && <p class="draft-notice">{res.str.blog_draft_notice()}</p>}
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{postDate(post.data.pubDate)}</time>
          {post.data.author && <span>{post.data.author}</span>}
          {post.data.updatedDate && <span>{res.str.blog_updated()} <time datetime={post.data.updatedDate.toISOString()}>{postDate(post.data.updatedDate)}</time></span>}
        </div>
        <p class="lead">{post.data.description}</p>
      </header>
      <div class="blog-prose"><Content /></div>
      <div class="post-footer"><a href={url('rss.xml')}>{res.str.blog_subscribe()}</a></div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post { max-width: 820px; }
  .back { display: inline-block; margin-bottom: 32px; }
  h1 { font-size: clamp(2.3rem, 5vw, 3.5rem); line-height: 1.15; letter-spacing: -.03em; overflow-wrap: anywhere; margin: 0 0 20px; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--muted); font-size: .9rem; }
  .lead { margin-block: 24px 36px; }
  .draft-notice { padding: 16px; border: 1px solid var(--border); border-radius: var(--radius); }
  .blog-prose { font-size: 1.05rem; line-height: 1.8; overflow-wrap: anywhere; }
  .blog-prose :global(h2), .blog-prose :global(h3) { line-height: 1.3; margin-top: 2em; }
  .blog-prose :global(img), .blog-prose :global(video) { max-width: 100%; height: auto; }
  .blog-prose :global(pre) { padding: 20px; overflow-x: auto; border-radius: var(--radius); font-size: .9rem; }
  .blog-prose :global(blockquote) { margin-inline: 0; padding-left: 24px; border-left: 3px solid var(--brand); color: var(--muted); }
  .blog-prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .blog-prose :global(th), .blog-prose :global(td) { padding: 10px 14px; border: 1px solid var(--border); }
  .post-footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border-soft); }
</style>
