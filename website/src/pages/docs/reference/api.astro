import DocsLayout from '../../../layouts/DocsLayout.astro';
import api from '../../../data/api-crates.json';

import external from '../../../data/external-crates.json';
import guides from '../../../data/reference-crates.json';

const guideFor = (pkg: string) => (guides as Record<string, string>)[pkg];
const groups = api.groups.map((group) => ({
  ...group,
  crates: [
    ...group.crates.map((crate) => ({
      ...crate,
      href: `https://daybrite.dev/api/${'lib' in crate ? crate.lib : crate.pkg.replace(/-/g, '_')}/index.html`,
      guide: guideFor(crate.pkg),
      label: 'API on daybrite.dev',
    })),
    ...external.filter((crate) => crate.group === group.name).map((crate) => ({
      ...crate, href: crate.api, label: `API on docs.rs · ${crate.version}`,
    })),
  ],
}));
groups.push({
  name: 'Example libraries',
  blurb: 'Reusable examples with their own published APIs.',
  crates: external.filter((crate) => crate.group === 'Example libraries').map((crate) => ({
    ...crate, href: crate.api, label: `API on docs.rs · ${crate.version}`,
  })),
});
---
<DocsLayout title="API reference" description="Generated Rust API documentation (rustdoc) for the public Day crates.">
  <h1>API reference</h1>
  <p class="lead">
    Generated <code>rustdoc</code> for the public Day crates. The guides explain the concepts;
    rustdoc provides signatures, methods, variants, and source links for the crates below.
    Built-in APIs are built from the same Day checkout as this site, using the portable mock
    backend for the umbrella crate. External crates link to versioned releases on docs.rs.
    Target-specific APIs may require documentation built for that target.
  </p>

  {groups.map((g) => (
    <section class="api-group">
      <h2>{g.name}</h2>
      <p class="group-blurb">{g.blurb}</p>
      <div class="api-cards">
        {g.crates.map((c) => (
          <article class="api-card">
            <a href={c.href}><code>{c.pkg}</code></a>
            <span>{c.blurb}</span>
            <small>{c.label}</small>
            {c.guide && <a class="guide-link" href={c.guide}>Setup and usage guide →</a>}
          </article>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>

<style>
  .lead { color: var(--muted); font-size: 1.05rem; }
  .api-group { margin-top: 34px; }
  .api-group h2 { margin: 0 0 4px; font-size: 1.25rem; }
  .group-blurb { margin: 0 0 16px; color: var(--muted); font-size: 0.95rem; }
  .api-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .api-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.12s ease;
  }
  .api-card small { color: var(--muted); font-size: 0.78rem; }
  .guide-link { font-size: 0.9rem; margin-top: auto; padding-top: 8px; }
  .api-card:hover { border-color: var(--brand); transform: translateY(-2px); }
  .api-card code { color: var(--text); font-weight: 700; font-size: 0.98rem; }
  .api-card span { color: var(--muted); font-size: 0.9rem; line-height: 1.45; }
</style>
