// SPDX-License-Identifier: CC-BY-SA-4.0
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { url, internalTitle, internalExcerpt } from '../../../lib/site';
import { groups, orderedIds } from '../../../lib/internal-groups.mjs';

// The internal reference docs are the repo's top-level `docs/*.md`, symlinked into
// src/content/internal (see content.config.ts). They have no frontmatter, so titles/descriptions
// are derived from the filename / body. `docs/` remains the single source of truth.
const entries = await getCollection('internal');
const byId = new Map(entries.map((e) => [e.id, e]));

// The curated groupings live in ONE place (src/lib/internal-groups.mjs), shared with the
// reference-index generator and gated by scripts/ci/doc-links.py. A doc missing from the
// curation fails the build here rather than slipping into an unlabeled bucket.
const grouped = new Set(orderedIds);
const unplaced = entries.filter((e) => !grouped.has(e.id)).map((e) => e.id);
if (unplaced.length) {
  throw new Error(
    `internal docs missing from src/lib/internal-groups.mjs: ${unplaced.join(', ')} — place them in a group`,
  );
}
const sections = groups
  .map((g) => ({
    heading: g.heading,
    blurb: g.blurb,
    items: g.docs.filter(([id]) => byId.has(id)).map(([id]) => byId.get(id)!),
  }))
  .filter((s) => s.items.length > 0);

const total = entries.length;
---
<DocsLayout
  title="Internal docs"
  description="Day framework internal reference: the repo's docs/ folder, rendered for the web."
  active="internal"
>
  <h1>Internal reference docs</h1>
  <p class="lead">
    These are Day's <strong>framework internal docs</strong>: the design and reference notes that
    live in the repository's <code>docs/</code> folder, rendered here for easy reading. They are
    written for contributors and framework authors, and are the source of truth for how each
    subsystem works. If you are building an app, start with the curated
    <a href={url('docs/overview')}>Documentation</a> instead.
  </p>

  {sections.map((s) => (
    <section class="group">
      <h2>{s.heading}</h2>
      <p class="group-blurb">{s.blurb}</p>
      <div class="doc-cards">
        {s.items.map((e) => (
          <a class="doc-card" href={url(`docs/internal/${e.id}`)}>
            <h3>{e.data.title ?? internalTitle(e.id)}</h3>
            <p>{e.data.description ?? internalExcerpt(e.body ?? '')}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p class="count" data-pagefind-ignore>{total} internal documents.</p>
</DocsLayout>

<style>
  .group { margin-top: 8px; }
  .group h2 { border-top: 1px solid var(--border-soft); }
  .group-blurb { color: var(--muted); margin: 0 0 18px; max-width: 70ch; }
  .doc-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; margin-top: 8px; }
  .doc-card {
    display: block;
    padding: 18px 20px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.12s ease;
  }
  .doc-card:hover { border-color: var(--brand); transform: translateY(-2px); }
  .doc-card h3 { margin: 0 0 6px; color: var(--text); font-size: 1.05rem; }
  .doc-card p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
  .count { color: var(--faint); font-size: 0.85rem; margin-top: 40px; }
</style>
