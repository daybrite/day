---
import BaseLayout from '../layouts/BaseLayout.astro';
import manifest from '../data/gallery-manifest.json';
import { site, url } from '../lib/site';
import DeviceShell from '../components/DeviceShell.astro';
import PlatformIcon from '../components/PlatformIcon.astro';

// The manifest is assembled before every build by the gallery integration: from CI screenshot
// artifacts on GitHub Actions, or as placeholders locally. See integrations/gallery.mjs.
//
// Layout: one ROW per curated shot (e.g. "Canvas gauge"), every platform's capture of that
// shot laid out horizontally in a scrolling strip. Two segmented selectors (theme, language)
// swap every visible tile between its captured variants client-side — each <img> carries all
// of its variant URLs as data attributes, and the tiny inline script below resolves the best
// available variant per tile (falling back visibly when a combination wasn't captured, e.g.
// French is only captured in light).
const generated = manifest.generatedAt
  ? new Date(manifest.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

type Suite = (typeof manifest.suites)[number];
function platformOf(suite: Suite, id: string) {
  return suite.platforms.find((p) => p.id === id)!;
}
const mobileOs = new Set(['iOS', 'Android', 'HarmonyOS']);

// Deep links into the live web build. The shim treats the URL fragment as the app's route
// (`day_dom_set_hash` writes it, a `hashchange` listener reads it back), so appending `#canvas` to
// the app's own site (site.showcaseWeb) opens on Canvas & shapes. The route names are the keys of the `Section` enum in
// the showcase's src/lib.rs (daybrite/Day-Showcase) — mirrored here because a shot id is NOT always a route: several rows
// capture a STATE of a page rather than a page.
// `toolbars` and `map` are in the enum but NOT in the web build — asking for either lands on
// About. Checked by loading each fragment against the built app rather than read off the enum.
const WEB_ROUTES = new Set([
  'controls', 'dates', 'focus', 'text', 'textareas', 'localization', 'canvas', 'animation',
  'grid', 'list', 'refresh', 'tabs', 'stack', 'media', 'webview', 'menus', 'system', 'services',
  'resources', 'tweaks', 'crash', 'about',
]);
// Shots that photograph a state within a page, plus the two that are not routes at all:
// `preferences` is a separate window and `cover` a fullscreen presentation, so neither can be
// reached by fragment and neither gets a link.
const SHOT_ROUTE: Record<string, string | null> = {
  home: '',
  'list-item-100': 'list',
  'stack-detail': 'stack',
  'tabs-one': 'tabs',
  'toolbars-filtered': 'toolbars',
  preferences: null,
  cover: null,
  // The web build has no Toolbars page; both toolbar rows would land on About.
  toolbars: null,
  'toolbars-filtered': null,
};
/** The fragment a shot opens on, or null when the shot is not reachable by one. */
function webRoute(shotId: string): string | null {
  if (shotId in SHOT_ROUTE) return SHOT_ROUTE[shotId];
  return WEB_ROUTES.has(shotId) ? shotId : null;
}
---
<BaseLayout title="Gallery" description="The Day Showcase app running on native widgets on every target, light, dark, and localized, with screenshots taken straight from CI." active="gallery">
  <section class="section gal-hero">
    <div class="container">
      <p class="eyebrow">Screenshot gallery</p>
      <h1 class="gal-title">The same Rust program, <span class="grad-text">native on every platform</span>.</h1>
      <p class="lead">
        Every screenshot below is captured in CI by the dayscript walkthrough, one pass per
        theme and language, then assembled here automatically. Each row is one screen; scroll it
        sideways to compare platforms.
      </p>
      {generated
        ? <p class="gen">Latest run · {generated}</p>
        : <p class="gen preview">Preview build, so placeholders are shown. On the live site these fill in from CI artifacts.</p>}
      <p class="gen">
        <a href={url('showcase')}>Run the Showcase app</a> yourself: installed on
        your machine, or live in this browser.
      </p>

    </div>
  </section>

  {/* Secondary toolbar: pinned just below the site header so the theme/language selection can be
      changed while viewing any row, without scrolling back to the top. It lives at the top level of
      <main> (NOT inside the hero's .container) so its containing block is the whole page — that is
      what lets it stay stuck across every suite instead of scrolling away with the hero. */}
  <div class="gal-toolbar" data-pagefind-ignore>
    <div class="container gal-toolbar-inner">
      <span class="gal-toolbar-label">Preview</span>
      <div class="seg" role="radiogroup" aria-label="Theme" data-seg="theme">
        <button type="button" role="radio" aria-checked="true" data-value="light">Light</button>
        <button type="button" role="radio" aria-checked="false" data-value="dark">Dark</button>
      </div>
      <div class="seg" role="radiogroup" aria-label="Language" data-seg="locale">
        <button type="button" role="radio" aria-checked="true" data-value="en">English</button>
        <button type="button" role="radio" aria-checked="false" data-value="fr">Français</button>
        <button type="button" role="radio" aria-checked="false" data-value="ar">العربية</button>
        <button type="button" role="radio" aria-checked="false" data-value="zh-cn">中文</button>
      </div>
    </div>
  </div>

  {manifest.suites.map((suite, si) => (
    <section class="section suite">
      <div class="container">
        <h2 class="suite-title">{suite.label}</h2>
        <p class="lead suite-blurb">{suite.blurb}</p>
      </div>

      {/* Each row's id is its anchor — the front-page hero carousel links each screenshot to
          its row (`/gallery#<shot>`). Shot ids must stay unique across suites. */}
      <div class="rows" data-pagefind-ignore>
        {suite.shots.map((shot, ri) => (
          <div class="row" id={shot.id}>
            <div class="container row-head">
              <h3 class="row-title">{shot.label}</h3>
              {shot.source && (
                <a
                  class="row-src"
                  href={`${site.repo}/blob/main/${shot.source}`}
                  target="_blank"
                  rel="noopener"
                  title={`View the code this screen is rendered from: ${shot.source}`}
                >{shot.source.split('/').pop()}</a>
              )}
            </div>
            <div class="strip-wrap">
              <div class="strip container-pad">
                {shot.byPlatform.map((tile, ci) => {
                  const platform = platformOf(suite, tile.platform);
                  const variantEntries = Object.entries(tile.variants ?? {});
                  return (
                    <figure
                      class:list={['tile', { mobile: mobileOs.has(platform.os) }]}
                      data-suite={si}
                      data-r={ri}
                      data-c={ci}
                      data-shot={shot.label}
                      data-os={platform.os}
                      data-tk={platform.label}
                      data-plat={platform.id}
                    >
                      <div class="frame">
                        {(() => {
                          const body = tile.placeholder ? (
                            <div class="ph" aria-label={`${shot.label} on ${platform.os} ${platform.label}, preview placeholder`}>
                              <span class="ph-mark">◱</span>
                              <span class="ph-txt">preview</span>
                            </div>
                          ) : (
                            <img
                              alt={`${shot.label}, ${platform.os} ${platform.label}`}
                              loading="lazy"
                              decoding="async"
                              class="var-img"
                              {...Object.fromEntries(
                                variantEntries.map(([v, img]) => [`data-src-${v}`, url(img.src)]),
                              )}
                              src={url((tile.variants.light ?? variantEntries[0][1]).src)}
                            />
                          );
                          return (
                            <>
                              <DeviceShell
                                platform={platform.id}
                                title={suite.label}
                                w={(tile.variants?.light ?? variantEntries[0]?.[1])?.width}
                                h={(tile.variants?.light ?? variantEntries[0]?.[1])?.height}
                              >{body}</DeviceShell>
                              {!tile.placeholder && <span class="fb-badge" hidden></span>}
                            </>
                          );
                        })()}
                      </div>
                      <figcaption data-pf={platform.id}>
                        <span class="cap-os">
                          {platform.os}
                          {platform.id === 'web-dom' && webRoute(shot.id) !== null && (
                            <a
                              class="cap-launch"
                              href={`${site.showcaseWeb}${webRoute(shot.id) ? `#${webRoute(shot.id)}` : ''}`}
                              target="_blank"
                              rel="noopener"
                              title={`Open this screen in the live web build`}
                            >{webRoute(shot.id) ? `launch #${webRoute(shot.id)}` : 'launch'}</a>
                          )}
                        </span>
                        <span class="cap-tk">
                          <PlatformIcon id={platform.id} class="cap-icon" />
                          {platform.label}
                        </span>
                      </figcaption>
                    </figure>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  {/* Full-size viewer. A custom lightbox (rather than a stock gallery library) because navigation
      is 2-D and platform-aware: ←/→ cycle platforms across the SAME screen (row); ↑/↓ move to the
      previous/next screen at the SAME platform (column). Opened by clicking a screenshot. */}
  <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Screenshot viewer">
    <div class="lb-backdrop" data-lb-close></div>
    <button class="lb-btn lb-close" data-lb-close type="button" aria-label="Close (Esc)">✕</button>
    <button class="lb-btn lb-arrow lb-up" data-lb-dir="up" type="button" aria-label="Previous screen, same platform (↑)">↑</button>
    <button class="lb-btn lb-arrow lb-down" data-lb-dir="down" type="button" aria-label="Next screen, same platform (↓)">↓</button>
    <button class="lb-btn lb-arrow lb-left" data-lb-dir="left" type="button" aria-label="Previous platform (←)">‹</button>
    <button class="lb-btn lb-arrow lb-right" data-lb-dir="right" type="button" aria-label="Next platform (→)">›</button>
    <figure class="lb-stage">
      <img class="lb-img" data-lb-img alt="" hidden />
      <div class="lb-empty" data-lb-empty hidden>Not captured on this platform yet</div>
      <figcaption class="lb-cap">
        <span class="lb-shot" data-lb-shot></span>
        <span class="lb-plat"><i class="lb-icon" data-lb-icon aria-hidden="true"></i><b data-lb-os></b><span data-lb-tk></span></span>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<script>
  // Variant switching: each .var-img carries data-src-<variant>. The selected (theme, locale)
  // pair resolves to a preference order; the first variant a tile actually has wins, and a
  // small badge names the fallback when the exact combination wasn't captured (e.g. French is
  // captured in light only, and some toolkits can't force dark).
  //
  // The preview theme starts on the SITE theme (html[data-theme], set before paint by BaseLayout):
  // a dark-mode visitor lands on the dark captures. It keeps tracking the site theme toggle until
  // the visitor picks a preview theme themselves — an explicit choice pins it.
  const siteTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  const state = { theme: siteTheme(), locale: 'en' };
  let themePinned = false;

  // Variant ids are `<theme>` for English and `<theme>-<locale>` otherwise (lowercased),
  // matching gallery.config.mjs. Fallback order: same locale in the other theme, then English
  // in the requested theme, then English light/dark — never silently a different locale when
  // the requested one exists in either theme.
  function variantId(theme: string, locale: string): string {
    return locale === 'en' ? theme : `${theme}-${locale}`;
  }

  function preferenceOrder(): string[] {
    const other = state.theme === 'dark' ? 'light' : 'dark';
    const order = [
      variantId(state.theme, state.locale),
      variantId(other, state.locale),
      variantId(state.theme, 'en'),
      variantId(other, 'en'),
    ];
    return [...new Set(order)];
  }

  const badgeText: Record<string, string> = {
    light: 'en · light',
    dark: 'en · dark',
    'light-fr': 'fr · light',
    'dark-fr': 'fr · dark',
    'light-ar': 'ar · light',
    'dark-ar': 'ar · dark',
    'light-zh-cn': '中文 · light',
    'dark-zh-cn': '中文 · dark',
  };

  function applyVariants(): void {
    const order = preferenceOrder();
    const want = order[0];
    for (const img of document.querySelectorAll<HTMLImageElement>('img.var-img')) {
      let chosen: string | null = null;
      for (const v of order) {
        const src = img.dataset[`src-${v}`.replace(/-([a-z])/g, (_, c) => c.toUpperCase())];
        if (src) {
          chosen = v;
          if (img.getAttribute('src') !== src) img.setAttribute('src', src);
          break;
        }
      }
      const win = img.closest<HTMLElement>('.sh-win');
      if (win) win.toggleAttribute('data-dark', chosen !== null && chosen.startsWith('dark'));
      const badge = img.closest<HTMLElement>('.frame')?.querySelector<HTMLElement>('.fb-badge');
      if (badge) {
        const fellBack = chosen !== null && chosen !== want;
        badge.hidden = !fellBack;
        if (fellBack && chosen) badge.textContent = badgeText[chosen] ?? chosen;
      }
    }
  }

  function reflectThemeSeg(): void {
    const seg = document.querySelector<HTMLElement>('.seg[data-seg="theme"]');
    for (const b of seg?.querySelectorAll('button') ?? []) {
      b.setAttribute('aria-checked', b.dataset.value === state.theme ? 'true' : 'false');
    }
  }

  for (const seg of document.querySelectorAll<HTMLElement>('.seg[data-seg]')) {
    const key = seg.dataset.seg as 'theme' | 'locale';
    seg.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
      if (!btn) return;
      if (key === 'theme') themePinned = true;
      state[key] = btn.dataset.value!;
      for (const b of seg.querySelectorAll('button')) {
        b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
      }
      applyVariants();
    });
  }

  // Land on the site theme's captures (the server-rendered markup assumes light/en), and follow
  // the site theme toggle live while the preview theme is unpinned.
  reflectThemeSeg();
  applyVariants();
  new MutationObserver(() => {
    if (themePinned || state.theme === siteTheme()) return;
    state.theme = siteTheme();
    reflectThemeSeg();
    applyVariants();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // ---- Full-size lightbox: 2-D, platform-aware navigation ----
  //   ←/→  cycle platforms across the SAME screen (the tiles of one row)
  //   ↑/↓  move to the previous/next screen at the SAME platform (same column index)
  // The grid is uniform (every screen lists every platform in the same order), so a fixed column
  // index IS the platform. Landing on an uncaptured cell shows a "not captured" note.
  (() => {
    const box = document.querySelector<HTMLElement>('[data-lightbox]');
    if (!box) return;
    const imgEl = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const emptyEl = box.querySelector<HTMLElement>('[data-lb-empty]')!;
    const shotEl = box.querySelector<HTMLElement>('[data-lb-shot]')!;
    const osEl = box.querySelector<HTMLElement>('[data-lb-os]')!;
    const tkEl = box.querySelector<HTMLElement>('[data-lb-tk]')!;
    const lbIcon = box.querySelector<HTMLElement>('[data-lb-icon]');

    // grid[suite][row][col] = <figure>
    const grid: HTMLElement[][][] = [];
    const figures = Array.from(document.querySelectorAll<HTMLElement>('figure.tile[data-suite]'));
    for (const fig of figures) {
      const s = Number(fig.dataset.suite), r = Number(fig.dataset.r), c = Number(fig.dataset.c);
      (grid[s] ??= [])[r] ??= [];
      grid[s][r][c] = fig;
    }

    let cur: { s: number; r: number; c: number } | null = null;

    function srcOf(fig: HTMLElement): string | null {
      const im = fig.querySelector<HTMLImageElement>('img.var-img');
      return im ? im.getAttribute('src') : null;
    }

    function render(): void {
      if (!cur) return;
      const fig = grid[cur.s]?.[cur.r]?.[cur.c];
      if (!fig) return;
      const src = srcOf(fig);
      if (src) {
        imgEl.setAttribute('src', src);
        imgEl.alt = `${fig.dataset.shot}, ${fig.dataset.os} ${fig.dataset.tk}`;
        imgEl.hidden = false;
        emptyEl.hidden = true;
      } else {
        imgEl.hidden = true;
        imgEl.removeAttribute('src');
        emptyEl.hidden = false;
      }
      shotEl.textContent = fig.dataset.shot ?? '';
      osEl.textContent = fig.dataset.os ?? '';
      tkEl.textContent = fig.dataset.tk ?? '';
      // Reuse the tile's own mark rather than shipping a second copy of every icon.
      if (lbIcon) lbIcon.innerHTML = fig.querySelector('.cap-icon')?.outerHTML ?? '';
      // The platform accent (global.css [data-pf] → --pf) tints the caption's platform line.
      if (fig.dataset.plat) box.setAttribute('data-pf', fig.dataset.plat);
    }

    function open(s: number, r: number, c: number): void {
      cur = { s, r, c };
      box!.hidden = false;
      box!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      render();
      box!.querySelector<HTMLElement>('.lb-close')?.focus();
    }
    function close(): void {
      box!.hidden = true;
      box!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      cur = null;
    }

    function navigate(dir: string): void {
      if (!cur) return;
      const rows = grid[cur.s];
      if (!rows) return;
      if (dir === 'left' || dir === 'right') {
        const n = rows[cur.r].length;
        cur.c = (cur.c + (dir === 'right' ? 1 : n - 1)) % n; // cycle platforms
      } else {
        const n = rows.length;
        let nr = cur.r;
        for (let i = 0; i < n; i++) {
          nr = (nr + (dir === 'down' ? 1 : n - 1)) % n; // same platform (column), wrap rows
          if (rows[nr]?.[cur.c]) break;
        }
        cur.r = nr;
      }
      render();
    }

    // Open on click / Enter / Space of a real (non-placeholder) tile.
    for (const fig of figures) {
      const frame = fig.querySelector<HTMLElement>('.frame');
      if (!frame || !fig.querySelector('img.var-img')) continue;
      frame.setAttribute('role', 'button');
      frame.setAttribute('tabindex', '0');
      frame.setAttribute('aria-label', `Open ${fig.dataset.shot} on ${fig.dataset.os} ${fig.dataset.tk}`);
      const go = () => open(Number(fig.dataset.suite), Number(fig.dataset.r), Number(fig.dataset.c));
      frame.addEventListener('click', go);
      frame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
      });
    }

    box.querySelectorAll<HTMLElement>('[data-lb-dir]').forEach((btn) =>
      btn.addEventListener('click', () => navigate(btn.dataset.lbDir!)),
    );
    box.querySelectorAll<HTMLElement>('[data-lb-close]').forEach((el) =>
      el.addEventListener('click', close),
    );

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      const k = e.key;
      if (k === 'Escape') return close();
      const dir = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' }[k];
      if (dir) { e.preventDefault(); navigate(dir); }
    });
  })();
</script>

<style>
  .gal-hero { padding-block: 56px 8px; }
  .gal-title { font-size: clamp(2rem, 4.6vw, 3rem); margin: 0 0 16px; }
  .gen { color: var(--faint); font-size: 0.9rem; margin-top: 16px; }
  .gen.preview { color: var(--sun); }

  /* Secondary toolbar: full-bleed, pinned just under the sticky 62px site header, hovering over the
     rows so theme/language can be switched from anywhere on the page (not only from the hero). */
  .gal-toolbar {
    position: sticky; top: 61px; z-index: 40;
    margin-top: 18px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  .gal-toolbar-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    padding-block: 10px;
  }
  .gal-toolbar-label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint); margin-right: 4px;
  }
  .seg {
    display: inline-flex; padding: 3px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }
  .seg button {
    appearance: none; border: 0; cursor: pointer;
    font: inherit; font-size: 0.86rem; font-weight: 650;
    color: var(--muted); background: transparent;
    padding: 6px 16px; border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .seg button[aria-checked='true'] { background: var(--hover); color: var(--fg, inherit); }

  .suite { padding-block: 16px 28px; }
  .suite-title { font-size: 1.7rem; margin: 0 0 6px; }
  .suite-blurb { margin: 0 0 4px; }

  /* Anchor landings (hero-carousel links, #<shot> URLs) must clear the sticky site header
     (61px) + the pinned theme/language toolbar below it. */
  .row { margin-top: 30px; scroll-margin-top: 132px; }
  .row-head { display: flex; align-items: baseline; gap: 12px; }
  .row-title {
    font-size: 0.95rem; font-weight: 700; margin: 0 0 12px;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--sun);
  }
  /* The page-source link: the file the row's screen is rendered from, monospace like a path. */
  .row-src {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.74rem; color: var(--faint);
    text-decoration: none;
    border: 1px solid var(--border); border-radius: 999px;
    padding: 2px 10px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .row-src::before { content: '</> '; opacity: 0.65; }
  .row-src:hover { color: var(--muted); border-color: var(--muted); text-decoration: none; }
  /* Full-bleed horizontal strip: the row scrolls sideways independently of the page. */
  .strip-wrap { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .strip {
    display: flex; gap: 16px; align-items: flex-start;
    width: max-content;
    padding-bottom: 10px;
  }
  /* Match .container's gutters so the first tile aligns with the heading. */
  .container-pad { padding-inline: max(24px, calc((100vw - 1160px) / 2)); }

  /* Desktop cells are wide (landscape screens read better); every frame is the SAME tall height
     as the mobile frames, so rows line up across platforms regardless of aspect ratio. Phone shots
     are ~0.46 aspect and need the height to render the full screen (incl. the home indicator).

     The desktop width is sized so a landscape capture FILLS that shared height instead of sitting
     short in the middle of it: the widest desktop shots are ~1.53:1 (macOS), and the frame's
     usable box is 500px less 10px padding and 1px border either side = 478px, so 478 × 1.53 ≈ 732px
     of image + 22px of chrome ≈ 754px. Narrower captures (GTK's ~0.94:1 About window) become
     height-limited and simply sit narrower inside the same cell. The `clamp` keeps a phone from
     scrolling two viewports per tile — it never goes below the previous 460px. */
  .tile { margin: 0; width: clamp(460px, calc(100vw - 48px), 754px); flex: 0 0 auto; }
  .tile.mobile { width: 240px; }
  .frame {
    position: relative;
    --frame-h: 500px;
    /* What a shell actually gets: the frame minus its padding and borders. DeviceShell derives
       the window width from this, so the two must stay in step. */
    --shell-h: calc(var(--frame-h) - 22px);
    height: var(--frame-h);
    /* An explicit, DEFINITE row: the implicit `auto` track would be sized by the image, so the
       image's `max-height: 100%` would resolve against its own height and never clamp — a
       taller-than-the-frame capture then silently cropped under `overflow: hidden` instead of
       scaling down. `minmax(0, …)` keeps the auto minimum from re-expanding the track. */
    display: grid; grid-template-rows: minmax(0, 1fr); place-items: center;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    padding: 10px;
    transition: border-color 0.15s ease;
  }
  /* A real (non-placeholder) tile opens the full-size viewer on click. */
  .frame:has(.var-img) { cursor: zoom-in; }
