---
// Copyright © The Daybrite Project
// SPDX-License-Identifier: CC-BY-SA-4.0
import BaseLayout from '../../layouts/BaseLayout.astro';
import manifest from '../../data/gallery-manifest.json';
import { url } from '../../lib/site';
import DeviceShell from '../../components/DeviceShell.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';

// One app's screenshots, read from the index its own site publishes (see
// scripts/assemble-gallery.mjs). The images are served by that app's site; this page links them.
//
// Layout: one ROW per captured screen, every platform's capture of that screen laid out
// horizontally in a scrolling strip. Where the app captured more than one theme or language,
// segmented selectors swap every visible tile between its captures client-side — each <img>
// carries all of them as data attributes, and the inline script resolves the best available
// (falling back visibly when a combination wasn't captured).
export function getStaticPaths() {
  return manifest.apps.map((app) => ({ params: { app: app.id }, props: { app } }));
}

type App = (typeof manifest.apps)[number];
const { app } = Astro.props as { app: App };

const columnOf = (id: string) => app.columns.find((c) => c.id === id)!;

const generated = app.indexGeneratedAt
  ? new Date(app.indexGeneratedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// A selector appears only for a dimension the app actually varied: most apps capture one theme,
// several capture one language, and a row of buttons with nothing to choose between is noise.
const themes = app.themes.length > 1 ? app.themes : [];
const locales = app.locales.length > 1 ? app.locales : [];
const initialTheme = app.themes.includes('light') ? 'light' : (app.themes[0] ?? 'default');
const initialLocale = app.locales.includes('en') ? 'en' : (app.locales[0] ?? 'default');
const key = (theme: string, locale: string) => `${theme || 'default'}|${locale || 'default'}`;
/** The data-attribute suffix for a capture key: `light|zh-CN` → `light-zh-cn`. */
const slug = (k: string) => k.replace(/\|/g, '-').replace(/[^a-z0-9-]+/gi, '-').toLowerCase();

const LOCALE_LABEL: Record<string, string> = {
  en: 'English',
  fr: 'Français',
  ar: 'العربية',
  'zh-CN': '中文',
};

/** The fragment a shot opens in the app's hosted web build, or null when it is not reachable. */
function webRoute(shotId: string): string | null {
  const routes = app.webRoutes as Record<string, string | null> | null;
  if (!routes || !(shotId in routes)) return null;
  return routes[shotId];
}

const description = `${app.label} on every platform it builds for: ${app.counts.captures} screenshots taken by the dayscript walkthrough its own CI runs, ${app.counts.shots} screens across ${app.counts.columns} native toolkits.`;
---
<BaseLayout title={`${app.label} gallery`} description={description} active="gallery">
  <section class="section gal-hero">
    <div class="container">
      <p class="eyebrow"><a href={url('gallery')}>Screenshot gallery</a></p>
      <h1 class="gal-title">{app.label}, <span class="accent-text">native on every platform</span>.</h1>
      <p class="lead">{app.blurb}</p>
      <p class="lead">
        Every screenshot below was taken by the <a href={url('docs/dayscript')}>dayscript</a>{' '}
        walkthrough that {app.label}'s own CI runs, and is served from{' '}
        {app.site ? <a href={app.site} target="_blank" rel="noopener">its own site</a> : 'its own site'}.
        Each row is one screen; scroll it sideways to compare platforms.
      </p>
      <p class="gen">
        {generated ? <span>Published {generated} · </span> : null}
        {app.counts.shots} screens · {app.counts.captures} captures · {app.counts.columns} toolkits
        {app.stale && <span class="stale"> · the app's site was unreachable, so this is the last index we read</span>}
      </p>
      <p class="gen gal-links">
        <a href={app.repo} target="_blank" rel="noopener">Source</a>
        {app.site && <a href={app.site} target="_blank" rel="noopener">Website</a>}
        {app.web && <a href={app.web} target="_blank" rel="noopener">Run it in this browser</a>}
      </p>
    </div>
  </section>

  {/* Secondary toolbar: pinned just below the site header so the theme/language selection can be
      changed while viewing any row, without scrolling back to the top. It lives at the top level of
      <main> (NOT inside the hero's .container) so its containing block is the whole page. */}
  {(themes.length > 0 || locales.length > 0) && (
    <div class="gal-toolbar" data-pagefind-ignore>
      <div class="container gal-toolbar-inner">
        <span class="gal-toolbar-label">Preview</span>
        {themes.length > 0 && (
          <div class="seg" role="radiogroup" aria-label="Theme" data-seg="theme">
            {themes.map((t) => (
              <button type="button" role="radio" aria-checked={t === initialTheme ? 'true' : 'false'} data-value={t}>
                {t[0].toUpperCase() + t.slice(1)}
              </button>
            ))}
          </div>
        )}
        {locales.length > 0 && (
          <div class="seg" role="radiogroup" aria-label="Language" data-seg="locale">
            {locales.map((l) => (
              <button type="button" role="radio" aria-checked={l === initialLocale ? 'true' : 'false'} data-value={l}>
                {LOCALE_LABEL[l] ?? l}
              </button>
            ))}
          </div>
        )}
      </div>
    </div>
  )}

  {/* Each row's id is its anchor — the front-page hero carousel and the platform doc pages link
      each screenshot to its row (`/gallery/<app>#<shot>`). The two data attributes carry the pair
      the server rendered, which is what the switcher script starts from: an app that captured one
      language still keys its captures under that language, not under `default`. */}
  <div class="rows" data-pagefind-ignore data-theme0={initialTheme} data-locale0={initialLocale}>
    {app.shots.map((shot, ri) => (
      <div class="row" id={shot.id}>
        <div class="container row-head">
          <h2 class="row-title">{shot.label}</h2>
          {shot.source && (
            <a
              class="row-src"
              href={`${app.repo}/blob/main/${shot.source}`}
              target="_blank"
              rel="noopener"
              title={`View the code this screen is rendered from: ${shot.source}`}
            >{shot.source.split('/').pop()}</a>
          )}
          {shot.caption && <p class="row-cap">{shot.caption}</p>}
        </div>
        <div class="strip-wrap">
          <div class="strip container-pad">
            {shot.byColumn.map((tile, ci) => {
              const column = columnOf(tile.column);
              const captures = Object.entries(tile.captures) as [
                string,
                { src: string; width?: number; height?: number },
              ][];
              const initial =
                tile.captures[key(initialTheme, initialLocale)] ?? captures[0][1];
              // Cell width follows the CAPTURE's own aspect, not its OS: every frame is the same
              // height (--frame-h, 500px less 22px of padding and borders), so a cell wide enough
              // for `height × aspect` is a cell the capture FILLS. Sizing by OS instead put a
              // 3:4 iPad walkthrough in the 240px cell a 0.46 phone wants, letterboxed to a
              // sliver; the CSS clamps the result to the phone and desktop bounds either way.
              const aspect =
                initial.width && initial.height ? initial.width / initial.height : 0.46;
              const cell = Math.round(478 * aspect) + 24; // + the shell's own chrome
              return (
                <figure
                  class="tile"
                  style={`--tile-w:${cell}px`}
                  data-r={ri}
                  data-c={ci}
                  data-shot={shot.label}
                  data-os={column.os}
                  data-tk={column.label}
                  data-plat={column.id}
                >
                  <div class="frame">
                    <DeviceShell
                      platform={column.id}
                      title={app.label}
                      host={app.site ?? undefined}
                      dark={initialTheme === 'dark'}
                      w={initial.width}
                      h={initial.height}
                    >
                      <img
                        alt={`${shot.label}, ${column.os} ${column.label}`}
                        loading="lazy"
                        decoding="async"
                        class="var-img"
                        {...Object.fromEntries(captures.map(([k, img]) => [`data-c-${slug(k)}`, img.src]))}
                        src={initial.src}
                      />
                    </DeviceShell>
                    <span class="fb-badge" hidden></span>
                  </div>
                  <figcaption data-pf={column.id}>
                    <span class="cap-os">
                      {column.os}
                      {column.id === 'web-dom' && app.web && webRoute(shot.id) !== null && (
                        <a
                          class="cap-launch"
                          href={`${app.web}${webRoute(shot.id) ? `#${webRoute(shot.id)}` : ''}`}
                          target="_blank"
                          rel="noopener"
                          title="Open this screen in the live web build"
                        >{webRoute(shot.id) ? `launch #${webRoute(shot.id)}` : 'launch'}</a>
                      )}
                    </span>
                    <span class="cap-tk">
                      <PlatformIcon id={column.id} class="cap-icon" />
                      {column.label}
                    </span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* Full-size viewer. A custom lightbox (rather than a stock gallery library) because navigation
      is 2-D and platform-aware: ←/→ cycle platforms across the SAME screen (row); ↑/↓ move to the
      previous/next screen at the SAME platform (column). Opened by clicking a screenshot. */}
  <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Screenshot viewer">
    <div class="lb-backdrop" data-lb-close></div>
    <button class="lb-btn lb-close" data-lb-close type="button" aria-label="Close (Esc)">✕</button>
    <button class="lb-btn lb-arrow lb-up" data-lb-dir="up" type="button" aria-label="Previous screen, same platform (↑)">↑</button>
    <button class="lb-btn lb-arrow lb-down" data-lb-dir="down" type="button" aria-label="Next screen, same platform (↓)">↓</button>
    <button class="lb-btn lb-arrow lb-left" data-lb-dir="left" type="button" aria-label="Previous platform (←)">‹</button>
    <button class="lb-btn lb-arrow lb-right" data-lb-dir="right" type="button" aria-label="Next platform (→)">›</button>
    <figure class="lb-stage">
      <img class="lb-img" data-lb-img alt="" hidden />
      <div class="lb-empty" data-lb-empty hidden>Not captured on this platform yet</div>
      <figcaption class="lb-cap">
        <span class="lb-shot" data-lb-shot></span>
        <span class="lb-plat"><i class="lb-icon" data-lb-icon aria-hidden="true"></i><b data-lb-os></b><span data-lb-tk></span></span>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<script>
  // Capture switching: each .var-img carries data-c-<theme>-<locale> for every capture the app
  // published for that tile. The selected pair resolves to a preference order; the first capture a
  // tile actually has wins, and a small badge names the fallback when the exact combination wasn't
  // captured (French is often captured in light only, and some toolkits can't force dark).
  //
  // The preview theme starts on the SITE theme (html[data-theme], set before paint by BaseLayout)
  // when the app captured one: a dark-mode visitor lands on the dark captures. It keeps tracking
  // the site theme toggle until the visitor picks a preview theme themselves.
  const root = document.querySelector<HTMLElement>('.rows')!;
  const segs = document.querySelectorAll<HTMLElement>('.seg[data-seg]');
  const valuesOf = (which: string) =>
    Array.from(
      document.querySelectorAll<HTMLElement>(`.seg[data-seg="${which}"] button[data-value]`),
      (b) => b.dataset.value!,
    );
  const themes = valuesOf('theme');
  const locales = valuesOf('locale');

  const siteTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  const state = {
    theme: themes.includes(siteTheme()) ? siteTheme() : root.dataset.theme0!,
    locale: root.dataset.locale0!,
  };
  let themePinned = false;

  /** The data-attribute suffix for a (theme, locale) pair — the same slug the page emitted. */
  function slug(theme: string, locale: string): string {
    return `${theme || 'default'}-${locale || 'default'}`.replace(/[^a-z0-9-]+/gi, '-').toLowerCase();
  }
  function datasetKey(theme: string, locale: string): string {
    return `c-${slug(theme, locale)}`.replace(/-([a-z0-9])/g, (_, c: string) => c.toUpperCase());
  }

  // Never silently a different LANGUAGE when the requested one exists in the other theme: the
  // requested locale leads in both themes before English is tried.
  function preferenceOrder(): string[][] {
    const others = themes.filter((t) => t !== state.theme);
    const fallbackLocale = root.dataset.locale0!;
    const pairs = [
      [state.theme, state.locale],
      ...others.map((t) => [t, state.locale]),
      [state.theme, fallbackLocale],
      ...others.map((t) => [t, fallbackLocale]),
      ['default', state.locale],
      [state.theme, 'default'],
      ['default', 'default'],
    ];
    const seen = new Set<string>();
    return pairs.filter(([t, l]) => {
      const k = `${t}|${l}`;
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
  }

  function label(theme: string, locale: string): string {
    const names: Record<string, string> = { fr: 'Français', ar: 'العربية', 'zh-CN': '中文', en: 'English' };
    const parts = [];
    if (locales.length > 1) parts.push(names[locale] ?? locale);
    if (themes.length > 1) parts.push(theme);
    return parts.join(' · ');
  }

  // Images this browser could not load. This page is built from indexes OTHER sites publish, so
  // an entry can outlive the file it names — an app republishes its gallery on its own schedule,
  // and a build here can be reading a copy from before or after a capture moved. A tile whose
  // every capture 404s hides itself, and a row that loses every tile goes with it, rather than
  // showing a reader a column of broken-image glyphs.
  const dead = new Set<string>();

  function applyCaptures(): void {
    const order = preferenceOrder();
    const [wantTheme, wantLocale] = order[0];
    for (const img of root.querySelectorAll<HTMLImageElement>('img.var-img')) {
      let chosen: string[] | null = null;
      for (const [t, l] of order) {
        const src = img.dataset[datasetKey(t, l)];
        if (src && !dead.has(src)) {
          chosen = [t, l];
          if (img.getAttribute('src') !== src) img.setAttribute('src', src);
          break;
        }
      }
      const tile = img.closest<HTMLElement>('figure.tile');
      // No capture left that loads: the tile has nothing to show.
      if (tile) tile.hidden = chosen === null;
      const win = img.closest<HTMLElement>('.sh-win');
      if (win) win.toggleAttribute('data-dark', chosen?.[0] === 'dark');
      const badge = img.closest<HTMLElement>('.frame')?.querySelector<HTMLElement>('.fb-badge');
      if (badge) {
        const fellBack = !!chosen && (chosen[0] !== wantTheme || chosen[1] !== wantLocale);
        badge.hidden = !fellBack;
        if (fellBack && chosen) badge.textContent = label(chosen[0], chosen[1]);
      }
    }
    for (const row of root.querySelectorAll<HTMLElement>('.row')) {
      row.hidden = !row.querySelector('figure.tile:not([hidden])');
    }
  }

  // `error` does not bubble, so it is captured. Retiring the failed URL and re-resolving lets a
  // tile fall through to another theme or language it does have, exactly as a missing capture
  // already does.
  root.addEventListener(
    'error',
    (e) => {
      const img = e.target as HTMLImageElement;
      if (!img.classList?.contains('var-img')) return;
      const src = img.getAttribute('src');
      if (!src || dead.has(src)) return;
      dead.add(src);
      applyCaptures();
    },
    true,
  );

  function reflectThemeSeg(): void {
    for (const b of document.querySelectorAll<HTMLElement>('.seg[data-seg="theme"] button')) {
      b.setAttribute('aria-checked', b.dataset.value === state.theme ? 'true' : 'false');
    }
  }

  for (const seg of segs) {
    const which = seg.dataset.seg as 'theme' | 'locale';
    seg.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
      if (!btn) return;
      if (which === 'theme') themePinned = true;
      state[which] = btn.dataset.value!;
      for (const b of seg.querySelectorAll('button')) {
        b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
      }
      applyCaptures();
    });
  }

  // Land on the site theme's captures, and follow the site theme toggle live while unpinned.
  reflectThemeSeg();
  applyCaptures();
  new MutationObserver(() => {
    if (themePinned || !themes.includes(siteTheme()) || state.theme === siteTheme()) return;
    state.theme = siteTheme();
    reflectThemeSeg();
    applyCaptures();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // ---- Full-size lightbox: 2-D, platform-aware navigation ----
  //   ←/→  cycle platforms across the SAME screen (the tiles of one row)
  //   ↑/↓  move to the previous/next screen at the SAME platform (same column index)
  // Landing on a cell the app didn't capture shows a "not captured" note.
  (() => {
    const box = document.querySelector<HTMLElement>('[data-lightbox]');
    if (!box) return;
    const imgEl = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const emptyEl = box.querySelector<HTMLElement>('[data-lb-empty]')!;
    const shotEl = box.querySelector<HTMLElement>('[data-lb-shot]')!;
    const osEl = box.querySelector<HTMLElement>('[data-lb-os]')!;
    const tkEl = box.querySelector<HTMLElement>('[data-lb-tk]')!;
    const lbIcon = box.querySelector<HTMLElement>('[data-lb-icon]');

    // grid[row][col] = <figure>
    const grid: HTMLElement[][] = [];
    const figures = Array.from(root.querySelectorAll<HTMLElement>('figure.tile'));
    for (const fig of figures) {
      const r = Number(fig.dataset.r), c = Number(fig.dataset.c);
      (grid[r] ??= [])[c] = fig;
    }

    let cur: { r: number; c: number } | null = null;

    function render(): void {
      if (!cur) return;
      const fig = grid[cur.r]?.[cur.c];
      if (!fig) return;
      const src = fig.querySelector<HTMLImageElement>('img.var-img')?.getAttribute('src') ?? null;
      if (src) {
        imgEl.setAttribute('src', src);
        imgEl.alt = `${fig.dataset.shot}, ${fig.dataset.os} ${fig.dataset.tk}`;
        imgEl.hidden = false;
        emptyEl.hidden = true;
      } else {
        imgEl.hidden = true;
        imgEl.removeAttribute('src');
        emptyEl.hidden = false;
      }
      shotEl.textContent = fig.dataset.shot ?? '';
      osEl.textContent = fig.dataset.os ?? '';
      tkEl.textContent = fig.dataset.tk ?? '';
      // Reuse the tile's own mark rather than shipping a second copy of every icon.
      if (lbIcon) lbIcon.innerHTML = fig.querySelector('.cap-icon')?.outerHTML ?? '';
      // The platform accent (global.css [data-pf] → --pf) tints the caption's platform line.
      if (fig.dataset.plat) box.setAttribute('data-pf', fig.dataset.plat);
    }

    function open(r: number, c: number): void {
      cur = { r, c };
      box!.hidden = false;
      box!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      render();
      box!.querySelector<HTMLElement>('.lb-close')?.focus();
    }
    function close(): void {
      box!.hidden = true;
      box!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      cur = null;
    }

    // A tile that hid itself (every capture failed to load) is skipped in both axes, so the
    // arrows never land on an empty cell the page is no longer showing.
    const shown = (r: number, c: number) => !!grid[r]?.[c] && !grid[r][c].hidden;

    function navigate(dir: string): void {
      if (!cur) return;
      if (dir === 'left' || dir === 'right') {
        const n = grid[cur.r].length;
        let nc = cur.c;
        for (let i = 0; i < n; i++) {
          nc = (nc + (dir === 'right' ? 1 : n - 1)) % n; // cycle platforms
          if (shown(cur.r, nc)) break;
        }
        cur.c = nc;
      } else {
        const n = grid.length;
        let nr = cur.r;
        for (let i = 0; i < n; i++) {
          nr = (nr + (dir === 'down' ? 1 : n - 1)) % n; // same platform (column), wrap rows
          if (shown(nr, cur.c)) break;
        }
        cur.r = nr;
      }
      render();
    }

    for (const fig of figures) {
      const frame = fig.querySelector<HTMLElement>('.frame');
      if (!frame) continue;
      frame.setAttribute('role', 'button');
      frame.setAttribute('tabindex', '0');
      frame.setAttribute('aria-label', `Open ${fig.dataset.shot} on ${fig.dataset.os} ${fig.dataset.tk}`);
      const go = () => open(Number(fig.dataset.r), Number(fig.dataset.c));
      frame.addEventListener('click', go);
      frame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
      });
    }

    box.querySelectorAll<HTMLElement>('[data-lb-dir]').forEach((btn) =>
      btn.addEventListener('click', () => navigate(btn.dataset.lbDir!)),
    );
    box.querySelectorAll<HTMLElement>('[data-lb-close]').forEach((el) =>
      el.addEventListener('click', close),
    );

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      const k = e.key;
      if (k === 'Escape') return close();
      const dir = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' }[k];
      if (dir) { e.preventDefault(); navigate(dir); }
    });
  })();
</script>

<style>
  .gal-hero { padding-block: 56px 8px; }
  .gal-title { font-size: clamp(2rem, 4.6vw, 3rem); margin: 0 0 16px; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--brand); }
  .gen { color: var(--faint); font-size: 0.9rem; margin-top: 16px; }
  .stale { color: var(--sun); }
  .gal-links { display: flex; flex-wrap: wrap; gap: 18px; }

  /* Secondary toolbar: full-bleed, pinned just under the sticky 62px site header, hovering over the
     rows so theme/language can be switched from anywhere on the page (not only from the hero). */
  .gal-toolbar {
    position: sticky; top: 61px; z-index: 40;
    margin-top: 18px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  .gal-toolbar-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    padding-block: 10px;
  }
  .gal-toolbar-label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint); margin-right: 4px;
  }
  .seg {
    display: inline-flex; padding: 3px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }
  .seg button {
    appearance: none; border: 0; cursor: pointer;
    font: inherit; font-size: 0.86rem; font-weight: 650;
    color: var(--muted); background: transparent;
    padding: 6px 16px; border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .seg button[aria-checked='true'] { background: var(--hover); color: var(--fg, inherit); }

  .rows { padding-block: 8px 28px; }
  /* Anchor landings (hero-carousel links, #<shot> URLs) must clear the sticky site header
     (61px) + the pinned theme/language toolbar below it. */
  .row { margin-top: 30px; scroll-margin-top: 132px; }
  .row-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; }
  .row-title {
    font-size: 0.95rem; font-weight: 700; margin: 0 0 12px;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--sun);
  }
  /* The dayscript's own `caption:` for the screen, where it declared one. */
  .row-cap { flex-basis: 100%; margin: -6px 0 12px; color: var(--muted); font-size: 0.92rem; }
  /* The page-source link: the file the row's screen is rendered from, monospace like a path. */
  .row-src {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.74rem; color: var(--faint);
    text-decoration: none;
