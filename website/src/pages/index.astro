import BaseLayout from '../layouts/BaseLayout.astro';
import CodeSample from '../components/CodeSample.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import InstallCommand from '../components/InstallCommand.astro';
import Logo from '../components/Logo.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { url, site } from '../lib/site';
import { primaryPlatforms } from '../lib/platforms.mjs';

// The eight primary platform-toolkits for the "runs on" grid, in Day's canonical order.
// Each card wears its platform accent (global.css `--pf-<target>`, iOS-palette light/dark)
// via data-pf; the blurbs say what the toolkit is and where people actually meet it.
const blurbs: Record<string, string> = {
  'macos-appkit':
    'The Mac’s native toolkit: the same NSButton, NSTableView, and menu bar that Finder and Mail are made of. Packs as a signed, notarized .dmg.',
  'ios-uikit':
    'Apple’s UI framework for iPhone and iPad: real navigation pushes, tab bars, and system text handling. Ships as a normal .ipa.',
  'android-mdc':
    'Google’s native widgets over android.view, on phones, tablets, and foldables, themed by the OS and packaged as .apk or .aab.',
  'linux-gtk':
    'GNOME’s toolkit, styled by libadwaita. It is the desktop Ubuntu, Fedora, and Debian install by default. Ships as a flatpak.',
  'linux-qt':
    'The toolkit beneath KDE Plasma: the desktop of Kubuntu, openSUSE, and the Steam Deck. Portable enough that it is also a Day target on macOS and Windows.',
  'windows-xaml':
    'Windows 11’s native controls, hosted in a Win32 window with no framework runtime to install. Packs as .msix plus an installer.',
  'harmony-arkui':
    'HarmonyOS Next’s native UI framework, driven through its C node API on Huawei phones and tablets. Packs as a .hap.',
  'web-dom':
    'The browser’s own widgets: the same Rust compiled to WebAssembly, driving real <button> and <dialog> elements. Hosts as static files; open the live build.',
};

// The grid's eight, named and ordered by the platform table (src/lib/platforms.mjs); this page
// contributes only the blurb.
const targets = primaryPlatforms.map((p) => ({
  id: p.id,
  name: p.toolkit,
  os: p.os,
  blurb: blurbs[p.id],
}));

const heroCode = `use day::prelude::*;

fn counter() -> AnyPiece {
    let count = Signal::new(0i64);
    column((
        label(move || format!("{} clicks", count.get())),
        row((
            button("–").action(move || count.update(|c| *c -= 1)),
            button("+").action(move || count.update(|c| *c += 1)),
        )).spacing(8.0),
    ))
    .spacing(12.0)
    .padding(16.0)
    .any()
}`;

const navCode = `let section = Signal::new(String::new());
selector(section)
    .style(SelectorStyle::Sidebar)   // native split view / tabs / pushing list
    .item("home",     "Home",     home_page)
    .item("settings", "Settings", settings_page)`;

// Feature-card icons are Google Material Symbols (Rounded), Apache 2.0 —
// https://fonts.google.com/icons — inlined as path data (viewBox 0 -960 960 960).
// Each card tints its icon with an accent from the site palette.
const features = [
  {
    icon: 'm438-452-58-57q-11-11-27.5-11T324-508q-11 11-11 28t11 28l86 86q12 12 28 12t28-12l170-170q12-12 11.5-28T636-592q-12-12-28.5-12.5T579-593L438-452ZM326-90l-58-98-110-24q-15-3-24-15.5t-7-27.5l11-113-75-86q-10-11-10-26t10-26l75-86-11-113q-2-15 7-27.5t24-15.5l110-24 58-98q8-13 22-17.5t28 1.5l104 44 104-44q14-6 28-1.5t22 17.5l58 98 110 24q15 3 24 15.5t7 27.5l-11 113 75 86q10 11 10 26t-10 26l-75 86 11 113q2 15-7 27.5T802-212l-110 24-58 98q-8 13-22 17.5T584-74l-104-44-104 44q-14 6-28 1.5T326-90Zm52-72 102-44 104 44 56-96 110-26-10-112 74-84-74-86 10-112-110-24-58-96-102 44-104-44-56 96-110 24 10 112-74 86 74 84-10 114 110 24 58 96Zm102-318Z',
    color: 'var(--pf-android-mdc)',
    title: 'Apps your users recognize',
    body: 'Every control is the platform’s own: a real Mac button on macOS, real Material on Android. Text, scrolling, shortcuts, and dark mode behave the way each platform’s users already expect, and keep improving with OS updates you never have to ship.',
  },
  {
    icon: 'm422-232 207-248H469l29-227-185 267h139l-30 208Zm-62-128H236q-24 0-35.5-21.5T203-423l299-430q10-14 26-19.5t33 .5q17 6 25 21t6 32l-32 259h155q26 0 36.5 23t-6.5 43L416-100q-11 13-27 17t-31-3q-15-7-23.5-21.5T328-139l32-221Zm111-110Z',
    color: 'var(--sun)',
    title: 'No browser, no bundled engine',
    body: 'Day apps are small native binaries that talk directly to the operating system. With no embedded browser and no rendering engine, they start in milliseconds and install in megabytes.',
  },
  {
    icon: 'M155-75q-35-35-35-85t35-85q35-35 85-35 14 0 26 3t23 8l57-71q-28-31-39-70t-5-78l-81-27q-17 25-43 40t-58 15q-50 0-85-35T0-580q0-50 35-85t85-35q50 0 85 35t35 85v8l81 28q20-36 53.5-61t75.5-32v-87q-39-11-64.5-42.5T360-840q0-50 35-85t85-35q50 0 85 35t35 85q0 42-26 73.5T510-724v87q42 7 75.5 32t53.5 61l81-28v-8q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35q-32 0-58.5-15T739-515l-81 27q6 39-5 77.5T614-340l57 70q11-5 23-7.5t26-2.5q50 0 85 35t35 85q0 50-35 85t-85 35q-50 0-85-35t-35-85q0-20 6.5-38.5T624-232l-57-71q-41 23-87.5 23T392-303l-56 71q11 15 17.5 33.5T360-160q0 50-35 85t-85 35q-50 0-85-35Zm-35-465q17 0 28.5-11.5T160-580q0-17-11.5-28.5T120-620q-17 0-28.5 11.5T80-580q0 17 11.5 28.5T120-540Zm148.5 408.5Q280-143 280-160t-11.5-28.5Q257-200 240-200t-28.5 11.5Q200-177 200-160t11.5 28.5Q223-120 240-120t28.5-11.5Zm240-680Q520-823 520-840t-11.5-28.5Q497-880 480-880t-28.5 11.5Q440-857 440-840t11.5 28.5Q463-800 480-800t28.5-11.5ZM480-360q42 0 71-29t29-71q0-42-29-71t-71-29q-42 0-71 29t-29 71q0 42 29 71t71 29Zm268.5 228.5Q760-143 760-160t-11.5-28.5Q737-200 720-200t-28.5 11.5Q680-177 680-160t11.5 28.5Q703-120 720-120t28.5-11.5Zm120-420Q880-563 880-580t-11.5-28.5Q857-620 840-620t-28.5 11.5Q800-597 800-580t11.5 28.5Q823-540 840-540t28.5-11.5ZM480-840ZM120-580Zm360 120Zm360-120ZM240-160Zm480 0Z',
    color: 'var(--brand)',
    title: 'One codebase, one team',
    body: 'Six operating systems and the web from a single Rust program. A feature lands once and ships everywhere at the same time, instead of one implementation per platform drifting apart as schedules diverge.',
  },
  {
    icon: 'M423.5-743.5Q400-767 400-800t23.5-56.5Q447-880 480-880t56.5 23.5Q560-833 560-800t-23.5 56.5Q513-720 480-720t-56.5-23.5ZM360-120v-480q-49-4-99-11t-98-18q-17-4-27.5-19t-5.5-32q5-17 21-25t34-4q70 15 145.5 22t149.5 7q74 0 149.5-7T775-709q18-4 34 4t21 25q5 17-5.5 32T797-629q-48 11-98 18t-99 11v480q0 17-11.5 28.5T560-80q-17 0-28.5-11.5T520-120v-200h-80v200q0 17-11.5 28.5T400-80q-17 0-28.5-11.5T360-120Z',
    color: 'var(--pf-macos-appkit)',
    title: 'Accessibility & localization, built in',
    body: 'Screen-reader support uses each platform’s own accessibility tree, and every user-facing string is localized with Mozilla Fluent. The groundwork for accessibility requirements and new markets is in the framework, not on your backlog.',
  },
  {
    icon: 'M160-120q-33 0-56.5-23.5T80-200v-560q0-33 23.5-56.5T160-840h640q33 0 56.5 23.5T880-760v560q0 33-23.5 56.5T800-120H160Zm0-80h640v-560H160v560Zm200-80q17 0 28.5-11.5T400-320q0-17-11.5-28.5T360-360H240q-17 0-28.5 11.5T200-320q0 17 11.5 28.5T240-280h120Zm222-193-29-29q-12-12-28-11.5T497-501q-11 12-11.5 28t11.5 28l57 57q12 12 28 12t28-12l142-142q12-12 12-28t-12-28q-12-12-28.5-12T695-586L582-473Zm-222 33q17 0 28.5-11.5T400-480q0-17-11.5-28.5T360-520H240q-17 0-28.5 11.5T200-480q0 17 11.5 28.5T240-440h120Zm0-160q17 0 28.5-11.5T400-640q0-17-11.5-28.5T360-680H240q-17 0-28.5 11.5T200-640q0 17 11.5 28.5T240-600h120ZM160-200v-560 560Z',
    color: 'var(--pf-linux-qt)',
    title: 'Tested on every platform, every change',
    body: 'Each commit builds a full demo app on all twelve targets, drives it end to end, and captures screenshots. The gallery on this site is those exact artifacts.',
  },
  {
    icon: 'M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h640q33 0 56.5 23.5T880-720v480q0 33-23.5 56.5T800-160H160Zm0-80h640v-400H160v400Zm187-200-76-76q-12-12-11.5-28t12.5-28q12-11 28-11.5t28 11.5l104 104q12 12 12 28t-12 28L328-308q-11 11-27.5 11.5T272-308q-11-11-11-28t11-28l75-76Zm173 160q-17 0-28.5-11.5T480-320q0-17 11.5-28.5T520-360h160q17 0 28.5 11.5T720-320q0 17-11.5 28.5T680-280H520Z',
    color: 'var(--pf-web-dom)',
    title: 'One CLI for the whole pipeline',
    body: 'One command line creates, runs, tests, and packages signed installers for every platform: dmg, App Store, Android, flatpak, Windows. The same automation scripts drive the app everywhere, for CI and for AI-assisted development.',
  },
];

// One-paragraph contrasts for teams evaluating a cross-platform stack. Factual and
// non-disparaging — the docs' "Why Day" page carries the full, frank comparison.
const compare = [
  {
    name: 'Web-view shells',
    examples: 'Electron, Tauri',
    body: 'Fast to staff from a web team, but the interface runs in a browser engine, bundled with the app (Electron) or the system’s (Tauri). That brings the browser’s memory profile and its patch cadence.',
  },
  {
    name: 'Custom renderers',
    examples: 'Flutter, Iced',
    body: 'Pixel-identical screens everywhere, drawn by the framework rather than the platform. Text, scrolling, and accessibility are re-implementations, and the app looks the same everywhere instead of at home anywhere.',
  },
  {
    name: 'Per-platform native',
    examples: 'Swift + Kotlin + C++ teams',
    body: 'The most flexibility and fidelity, but paid for once per platform. Every feature is built, reviewed, and maintained N times, and the versions drift apart when schedules diverge.',
  },
];
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">
          <span class="hero-day">Day:</span> create native apps for every platform{' '}
          <span class="sun-text">under the sun</span> from a single Rust codebase
        </h1>
        <p class="lead hero-lead">{site.description}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={url('docs/overview')}>Read the docs</a>
          <a class="btn btn-ghost" href={url('gallery')}>See it running →</a>
        </div>
      </div>
      <div class="hero-media">
        <HeroCarousel />
      </div>
    </div>
    <div class="container hero-install">
      <InstallCommand />
    </div>
  </section>

  <!-- RUNS ON -->
  <section class="section runs">
    <div class="container">
      <p class="eyebrow">Runs natively on</p>
      <div class="pf-grid">
        {targets.map((t) => (
          <article class="pf-card" data-pf={t.id}>
            <div class="pf-head">
              <PlatformIcon id={t.id} class="pf-icon-mark" />
              <div class="pf-headings">
                <p class="pf-os">{t.os}</p>
                <h3 class="pf-name">{t.name}</h3>
                <code class="pf-id">{t.id}</code>
              </div>
            </div>
            <p class="pf-blurb">
              {t.id === 'web-dom' ? (
                <>
                  The browser’s own widgets: the same Rust compiled to WebAssembly, driving
                  real <code>&lt;button&gt;</code> and <code>&lt;dialog&gt;</code> elements.
                  Hosts as static files. <a href={site.showcaseWeb}>Open the live build</a>.
                </>
              ) : (
                t.blurb
              )}
            </p>
            <a class="pf-more" href={url(`docs/platforms/${t.id}`)}>
              Building for {t.os} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- THE CODE -->
  <section class="section codeshow">
    <div class="container codeshow-grid">
      <div class="codeshow-copy">
        <p class="eyebrow">One codebase, every platform</p>
        <h2 class="sec-title">One Rust function. A native app <span class="grad-text">everywhere</span>.</h2>
        <p class="lead">
          This is a complete, working counter, the whole thing. The same function becomes a real
          AppKit control on macOS, UIKit on iOS, Material on Android, and native GTK, Qt, XAML, and
          ArkUI widgets everywhere else. Those are the screenshots in the carousel above: real
          platform components, from this exact kind of code.
        </p>
        <ul class="how-list">
          <li><b>Just Rust:</b> plain functions and builder calls, with no markup language, no macros, and no per-platform branches.</li>
          <li><b>Reactive by binding:</b> change a signal and only the control showing it updates. No re-render, no virtual tree.</li>
          <li><b>Native on the other side:</b> the widgets it produces are the platform's own, not lookalikes drawn by an engine.</li>
        </ul>
        <div class="hero-cta">
          <a class="btn btn-ghost" href={url('docs/api-tour')}>See the full API tour →</a>
        </div>
      </div>
      <div class="codeshow-code">
        <CodeSample code={heroCode} title="counter.rs" />
        <p class="codeshow-note">One function, a native counter on all twelve targets.</p>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section features">
    <div class="container">
      <p class="eyebrow">Why Day</p>
      <h2 class="sec-title">Native quality <span class="grad-text">and</span> a single codebase.</h2>
      <p class="lead">
        Cross-platform tools usually make you choose between apps that feel native and a codebase
        you only write once. Day keeps both.
      </p>
      <div class="feat-grid">
        {features.map((f) => (
          <div class="card feat">
            <h3>
              <svg
                class="feat-ic"
                viewBox="0 -960 960 960"
                aria-hidden="true"
                style={`color: ${f.color}`}
              ><path fill="currentColor" d={f.icon} /></svg>
              {f.title}
            </h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI + CI -->
  <section class="section ai-ci">
    <div class="container">
      <p class="eyebrow">Agents & automation</p>
      <h2 class="sec-title">Built <span class="grad-text">for agents and CI</span>.</h2>
      <p class="lead">
        Every Day app embeds <b>dayscript</b>, the same automation engine that drives Day's own
        release pipeline. A YAML script, an agent over MCP, or your CI taps buttons, types text,
        asserts what's on screen by stable element ids, and captures screenshots, identically on
        every platform.
      </p>
      <ul class="how-list">
        <li>
          <b>Agents that see their work:</b> Claude Code and other MCP clients get the day tools
          (build, relaunch, drive, screenshot), so an LLM edits your app, drives the running build,
          and shows you pixels to prove the change landed.
        </li>
        <li>
          <b>One script, twelve targets:</b> run the walkthrough per theme and locale and the
          same YAML produces your localized screenshots. The
          <a href={url('gallery')}>gallery</a> on this site is exactly that.
        </li>
        <li>
          <b>Regressions caught in CI, not in reviews:</b> the walkthrough runs on every push; a
          failed assertion or a blank capture is a red build before it is ever a user report.
        </li>
      </ul>
      <div class="hero-cta">
        <a class="btn btn-primary" href={url('docs/ai')}>AI-assisted development →</a>
        <a class="btn btn-ghost" href={url('docs/dayscript')}>Testing with dayscript →</a>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="section compare">
    <div class="container">
      <p class="eyebrow">Evaluating your options</p>
      <h2 class="sec-title">What each approach trades away.</h2>
      <div class="cmp-grid">
        {compare.map((c) => (
          <div class="card cmp">
            <h3>{c.name}</h3>
            <p class="cmp-ex">{c.examples}</p>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
      <p class="lead cmp-close">
        Day keeps the platform's own components <em>and</em> the single codebase. It has limits
        too: no hot reload, a young ecosystem, and deliberate constraints on pixel-level branding.
      </p>
      <a class="btn btn-ghost" href={url('docs/benefits')}>Read the comparison →</a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how">
    <div class="container how-grid">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="sec-title">When data changes, the right control updates.</h2>
        <p class="lead">
          Day builds your interface from real platform components once, then keeps each one
          connected to your application's state. When a value changes, the exact label or control
          showing it updates. There is no re-rendering, no shadow copy of the interface to reconcile, no
          engine in between. Day apps perform like hand-written platform code because, at runtime,
          that's what they are.
        </p>
        <ul class="how-list">
          <li><b>Plain Rust:</b> functions and builder calls any engineer can read, with no macros and no separate UI language.</li>
          <li><b>Native navigation:</b> sidebars, tabs, and back-gestures are the platform's own containers.</li>
          <li><b>Testable end to end:</b> one automation script drives the app identically on every platform.</li>
        </ul>
        <div class="hero-cta">
          <a class="btn btn-ghost" href={url('docs/api-tour')}>Full API tour →</a>
          <a class="btn btn-ghost" href={url('docs/rendering')}>Under the hood →</a>
        </div>
      </div>
      <div class="how-code">
        <CodeSample code={navCode} title="navigation.rs" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container cta-inner">
      <Logo size={40} />
      <h2>Build it once. Ship it everywhere your users are.</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href={url('docs/getting-started')}>Get started</a>
        <a class="btn btn-ghost" href={url('gallery')}>Browse the gallery</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: 72px 40px; }
  .hero-glow {
    position: absolute;
    top: -280px; left: 50%;
    width: 1100px; height: 700px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(255, 150, 90, 0.22), rgba(106, 164, 255, 0.14) 55%, transparent 72%);
    filter: blur(6px);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 52px;
    align-items: center;
  }
  /* Grid items must be allowed to shrink below their content's intrinsic width, so a wide
     code block scrolls inside its own box instead of stretching the page. */
  .hero-grid > *, .how-grid > * { min-width: 0; }
  .hero-title { font-size: clamp(2.3rem, 5.2vw, 3.7rem); margin: 0 0 20px; font-weight: 800; line-height: 1.08; }
  /* "Day:" wears the carousel's active platform accent — HeroCarousel sets --hero-accent on
     the .hero section at every slide change, and transitioning `color` makes the hue glide
     between platforms instead of jumping. The duration is ~¾ of the carousel's 3400ms
     interval, so the color is in motion for most of every cycle — a continuous drift through
     the palette — settling just before the next advance. Before the first slide (or with no
     carousel manifest) it rests on the brand blue. */
  .hero-day { color: var(--hero-accent, var(--brand)); transition: color 2.6s ease-in-out; }
  /* "under the sun" in solid amber — a nod to the Ember Dawn mark. Deliberately not a
     gradient clip: one accent color keeps the headline from reading as a template hero. */
  .sun-text {
    color: var(--sun);
    white-space: nowrap;
  }
  .hero-lead { margin: 0 0 28px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-install { margin-top: 34px; }

  /* THE CODE (example moved down from the hero) */
  .codeshow-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .codeshow-grid > * { min-width: 0; }
  .codeshow-note { color: var(--faint); font-size: 0.84rem; margin: 14px 2px 0; text-align: center; }

  /* RUNS ON */
  /* Eight platform cards, one per target, each wearing its accent (data-pf → --pf).
     Explicit column counts per band: 4-up wide, 2-up narrow, 1-up mobile. */
  .pf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 8px; }
  @media (max-width: 980px) { .pf-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .pf-grid { grid-template-columns: 1fr; } }
  .pf-card {
    border: 1px solid var(--border-soft);
    border-top: 3px solid var(--pf);
    border-radius: var(--radius);
    padding: 16px 18px;
    background: var(--surface);
  }
  .pf-os {
    margin: 0 0 2px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pf) 78%, var(--text));
  }
  /* The mark sits beside the three title rows, centered against the block as a whole — the same
     header shape the showcase download cards use. */
  .pf-head { display: flex; align-items: center; gap: 13px; margin-bottom: 6px; }
  .pf-headings { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  /* :global — see the note on .dl-icon in showcase.astro: the svg carries PlatformIcon's scope. */
  .pf-card :global(.pf-icon-mark) {
    width: 34px;
    height: 34px;
    color: color-mix(in srgb, var(--pf) 78%, var(--text));
  }
  .pf-name { margin: 0 0 6px; font-size: 1.02rem; }
  .pf-id {
