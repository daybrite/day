---
// Copyright © The Daybrite Project
// SPDX-License-Identifier: CC-BY-SA-4.0
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import Logo from '../components/Logo.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { url, site } from '../lib/site';
import { primaryPlatforms } from '../lib/platforms.mjs';

const platforms = primaryPlatforms.filter((p) => p.id !== 'linux-qt');
const benefits = [
  { number: '01', title: 'Put more of your team behind one product.', body: 'Share your interface and application logic across platforms. Bring improvements to more users from the same codebase, and spend less time maintaining separate versions.', link: 'Explore the Day approach', path: 'docs/overview' },
  { number: '02', title: 'Make every device feel like home.', body: 'Give people the controls, text input, menus, and navigation they expect. Day uses each platform’s native interface, so your app belongs wherever it runs.', link: 'See Day apps in action', path: 'gallery' },
  { number: '03', title: 'Keep your next market within reach.', body: 'Start where your audience is today. Add desktop, mobile, or web as your product grows, building on the work you have already done.', link: 'Explore the platforms', path: 'docs/platforms' },
];
const stages = [
  { title: 'Create', body: 'Set up a project, choose your platforms, and build your first screens with shared components.', path: 'docs/getting-started' },
  { title: 'Develop', body: 'Build and run from VS Code. Connect platform services and make the interface your own.', path: 'docs/internal/vscode' },
  { title: 'Test', body: 'Replay real app workflows, check results, and capture screenshots across languages and themes.', path: 'docs/dayscript' },
  { title: 'Release', body: 'Prepare platform packages, configure signing, and manage store listings and release automation.', path: 'docs/packaging' },
  { title: 'Improve', body: 'Investigate crashes with user-approved reports and turn fixes into repeatable regression tests.', path: 'docs/guide-crash-reporting' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Day · The universal app framework</p>
        <h1>One app.<br />Every platform.<br /><span class="hero-day">All Day.</span></h1>
        <p class="lead">Bring your product to desktop, mobile, and web. Day gives your team a shared foundation to build, test, and deliver native apps across the consumer platforms your users call home.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('docs/getting-started')}>Start building</a>
          <a class="btn btn-ghost" href={url('gallery')}>Explore the possibilities →</a>
        </div>
      </div>
      <div class="hero-media"><HeroCarousel /></div>
    </div>
    <div class="container platform-strip" aria-label="Target platforms">
      {platforms.map((p) => <a href={url(`docs/platforms/${p.id}`)} data-pf={p.id}><PlatformIcon id={p.id} class="platform-icon" /><span>{p.os}</span></a>)}
    </div>
    <p class="container support-note">Platform capabilities and release support vary. <a href={url('docs/platforms')}>See current platform support →</a></p>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">More reach. Shared effort.</p>
      <h2>Build the product.<br />Bring it everywhere.</h2>
      <p class="section-lead">macOS, Windows, Linux, iPhone, iPad, Android, HarmonyOS, and the web—all from a single codebase. Keep your product moving forward across devices, with room for the details that make each platform different.</p>
      <div class="benefit-grid">
        {benefits.map((item) => <article class="capability"><span class="number" aria-hidden="true">{item.number}</span><h3>{item.title}</h3><p>{item.body}</p><a href={url(item.path)}>{item.link} →</a></article>)}
      </div>
    </div>
  </section>

  <section class="section performance" id="let-your-app-shine">
    <div class="container split">
      <div>
        <p class="eyebrow">The experience your users deserve</p>
        <h2>Let your app shine</h2>
        <p class="section-lead">Give your app the performance and polish it deserves. Day pairs platform-native controls with Rust’s bare-metal performance and memory safety, so your shared codebase delivers an experience that feels at home on every device.</p>
        <p class="section-lead">Day apps are free from the compromises of other cross-platform toolkits that render to pixels or web views. Your users get familiar text selection, keyboard behavior, scrolling, and accessibility—built on the platform’s own controls.</p>
        <a href={url('docs/benefits')}>Explore the native advantage →</a>
      </div>
      <div class="performance-facts">
        <article><h3>Compiled for the device</h3><p>Powered by Rust, Day compiles to machine code on native targets and WebAssembly for the browser.</p></article>
        <article><h3>The platform’s own controls</h3><p>Text, input, and scrolling draw on the same native toolkits used by the platform’s own applications.</p></article>
        <article><h3>Reactive and declarative</h3><p>When data changes, Day updates the controls that depend on it. The rest of the interface stays in place.</p></article>
      </div>
    </div>
  </section>

  <section class="section lifecycle">
    <div class="container">
      <p class="eyebrow">The complete development lifecycle</p>
      <h2>From your first idea<br />to your next release.</h2>
      <p class="section-lead">Day brings development tools, UI testing, localization, packaging, and release automation into one workflow. Carry the same project from a first prototype through launch and ongoing maintenance.</p>
      <ol class="stages">
        {stages.map((stage, i) => <li><span class="stage-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3><a href={url(stage.path)}>{stage.title} →</a></h3><p>{stage.body}</p></li>)}
      </ol>
      <p class="detail-note">Use the SDKs, signing credentials, and store accounts required by your release platforms. Day’s tools help coordinate the work.</p>
    </div>
  </section>

  <section class="section tooling">
    <div class="container split tooling-grid">
      <div>
        <p class="eyebrow">Day for Visual Studio Code</p>
        <h2>Your platforms.<br />One place to work.</h2>
        <p class="section-lead">Create projects, choose targets, manage devices, and build and launch apps from the editor. Run automated walkthroughs as you work, then open Xcode or Android Studio when you need to go deeper.</p>
        <a class="btn btn-primary" href="https://marketplace.visualstudio.com/items?itemName=daybrite.day-vscode">Get Day for VS Code</a>
      </div>
      <figure class="editor-shot">
        <!-- Source: daybrite/day-vscode, media/screenshot-cockpit.png. -->
        <a href="https://github.com/daybrite/day-vscode"><img src={url('images/day-vscode.png')} width="1440" height="900" loading="lazy" alt="The Day extension in VS Code, with project targets and device controls beside the editor." /></a>
        <figcaption>Manage the app and its platform targets from the Day view.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Built to grow with your ambitions</p>
      <h2>A foundation you can make your own.</h2>
      <div class="ownership-grid">
        <article class="capability"><h3>Extend what your app can do.</h3><p>Combine existing controls into reusable components, wrap a native widget, or connect a platform service. Package your additions separately and share them across your products.</p><a href={url('docs/extending')}>Explore the extension framework →</a></article>
        <article class="capability"><h3>Reach more people from the start.</h3><p>Build for different languages and assistive technologies as part of everyday development. Test translated screens and add accessible labels alongside the interface.</p><a href={url('docs/localization')}>Build for a global audience →</a></article>
        <article class="capability independent"><p class="eyebrow">Independent. Open source.</p><h3>Your product’s future belongs to you.</h3><p>Day is an independent open-source project, built on a shared foundation you can inspect, extend, and contribute to. Choose your own infrastructure and keep the framework’s source within reach.</p><p>Available under the Mozilla Public License 2.0.</p><a href={site.repo}>Explore the source →</a><a href={`${site.repo}/blob/main/LICENSE`}>Read the license →</a></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-inner">
      <Logo size={40} />
      <h2>Where will you take your next app?</h2>
      <p>Start with one idea. Build for a world of devices.</p>
      <div class="actions"><a class="btn btn-primary" href={url('docs/getting-started')}>Get started with Day</a><a class="btn btn-ghost" href={url('showcase')}>Try Day Showcase</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding-block: 80px 30px; }
  .hero-glow { position: absolute; top: -280px; left: 50%; width: 1100px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(255,150,90,.22), rgba(106,164,255,.14) 55%, transparent 72%); pointer-events: none; }
  h1 { font-size: clamp(2.7rem, 5.5vw, 4.3rem); line-height: 1.05; letter-spacing: -.045em; margin: 0 0 26px; }
  .hero-day { color: var(--hero-accent, var(--brand)); transition: color 2.6s ease-in-out; }
  h2 { font-size: clamp(1.9rem, 3.8vw, 2.8rem); line-height: 1.15; letter-spacing: -.025em; margin: 0 0 22px; }
  h3 { font-size: 1.25rem; line-height: 1.35; margin: 0 0 14px; }
  .lead { margin-bottom: 28px; }
  .section-lead { font-size: 1.12rem; line-height: 1.75; max-width: 65ch; color: var(--muted); margin: 0 0 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .platform-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px 32px; margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--border-soft); }
  .platform-strip a { display: flex; align-items: center; gap: 9px; color: var(--text); font-weight: 600; font-size: .9rem; }
  .platform-strip :global(.platform-icon) { width: 25px; height: 25px; color: var(--pf); }
  .support-note { margin-top: 20px; text-align: center; color: var(--muted); font-size: .85rem; }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 38px; }
  .capability { display: flex; flex-direction: column; padding: 30px; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--surface); }
  .capability p, .performance-facts p, .stages p { color: var(--muted); line-height: 1.7; margin: 0 0 22px; }
  .capability > a { margin-top: auto; font-weight: 600; font-size: .94rem; }
  .number { color: var(--sun); font: 500 2rem var(--mono); margin-bottom: 26px; }
  .performance { background: var(--surface); border-block: 1px solid var(--border-soft); }
  .performance-facts { border-left: 2px solid var(--brand); padding-left: 30px; }
  .performance-facts article + article { margin-top: 28px; }
  .performance-facts p { margin-bottom: 0; }
  .stages { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); list-style: none; padding: 0; margin: 40px 0 24px; gap: 24px; }
  .stages li { border-top: 2px solid var(--brand); padding-top: 20px; }
  .stage-number { display: block; color: var(--muted); font: .85rem var(--mono); margin-bottom: 16px; }
  .stages h3 { font-size: 1.1rem; }
  .stages p { font-size: .94rem; margin: 0; }
  .detail-note { color: var(--muted); font-size: .85rem; }
  .tooling { background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 8%, var(--bg)), var(--bg)); }
  .tooling-grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .editor-shot { margin: 0; }
  .editor-shot img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  figcaption { color: var(--muted); margin-top: 14px; font-size: .85rem; }
  .ownership-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 36px; }
  .independent { grid-column: 1 / -1; padding: 40px; background: linear-gradient(120deg, color-mix(in srgb, var(--sun) 9%, var(--surface)), var(--surface)); }
  .independent p { max-width: 75ch; }
  .independent > a + a { margin-top: 14px; }
  .cta-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 64px 28px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border-soft); }
  .cta-inner h2, .cta-inner p { margin: 0; }
  .cta-inner p { color: var(--muted); }
  @media (max-width: 1000px) { .stages { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* .hero-grid/.split and .hero-media stack in styles/global.css, which owns that layout. */
  @media (max-width: 880px) { .benefit-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; } .hero { padding-top: 40px; } }
  @media (max-width: 560px) { .ownership-grid, .stages { grid-template-columns: minmax(0, 1fr); } .capability, .independent { padding: 24px; } .platform-strip { gap: 18px; } .performance-facts { padding-left: 22px; } }
  @media (prefers-reduced-motion: reduce) { .hero-day { transition: none; } }
</style>
