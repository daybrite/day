import BaseLayout from '../layouts/BaseLayout.astro';
import { platformsById } from '../lib/platforms.mjs';
import { site, url } from '../lib/site';
import manifest from '../data/downloads.json';
import gallery from '../data/gallery-manifest.json';
import PlatformIcon from '../components/PlatformIcon.astro';
import CopyCommand from '../components/CopyCommand.astro';

// The showcase's own gallery page, when this build could read its index — the hub otherwise, so
// one app's site being unreachable costs a deep link rather than failing the whole build's
// link check.
const galleryHref = gallery.apps.some((a) => a.id === 'Day-Showcase')
  ? url('gallery/Day-Showcase')
  : url('gallery');

// The Day Showcase, packaged for every primary platform by `day pack` and attached to the latest
// GitHub release — the release lane is where the macOS build gets signed and notarized, so these
// are the packages that install without a fight. Names, sizes, digests and URLs come from
// src/data/downloads.json (scripts/assemble-downloads.mjs); a platform the release did not ship
// renders its placeholder instead of a download.
type ManifestFile = { name: string; bytes: number; href: string };
const byId = new Map<string, ManifestFile[]>(
  (manifest.platforms ?? []).map((p: { id: string; files: ManifestFile[] }) => [p.id, p.files]),
);
const release = manifest.release as { tag: string; url: string; publishedAt: string } | null;

// The two quick-start commands, built once so the rendered line and the string the Copy button
// puts on the clipboard cannot drift apart.
const unixCmdUrl = `${site.showcaseRepo}/releases/latest/download/launch.sh`;
const winCmdUrl = `${site.showcaseRepo}/releases/latest/download/launch.ps1`;

// web-dom is rendered ahead of these directly in the markup: there is nothing to download.
const packaging = [
  {
    id: 'android-mdc',
    kind: '.apk / .aab',
    store: 'google' as const,
    install:
      'Google Play installs and updates it like any other app. The .apk below is the same build for a device without Play: allow “Install unknown apps” for your browser or file manager when prompted, or use `adb install`. The .aab is the Play form (for bundletool, not direct install).',
  },
  {
    id: 'ios-uikit',
    kind: '.ipa',
    store: 'apple' as const,
    install:
      'The App Store build is the one to install. The unsigned device .ipa below is the same build for sideloading: AltStore Classic or SideStore re-sign it with your own Apple ID on install, or sign it yourself and install via Xcode’s Devices window.',
  },
  {
    id: 'harmony-arkui',
    kind: '.hap',
    install:
      'Development-signed for the public OpenHarmony certificate: install on an emulator or developer device with `hdc install <file>.hap`.',
  },
  {
    id: 'macos-appkit',
    kind: '.dmg',
    install:
      'Open the .dmg and drag Day Showcase into Applications. The build is signed and notarized, so it opens like any other Mac app.',
  },
  {
    id: 'windows-xaml',
    kind: '.msix + setup.exe',
    install:
      'Run the -setup.exe. SmartScreen interjects for an unsigned installer: choose “More info”, then “Run anyway”. The .msix package needs the development certificate trusted first, so the setup.exe is the easier path.',
  },
  {
    id: 'linux-gtk',
    kind: '.appimage',
    install:
      'One self-contained executable carrying its own GTK: `chmod +x ./<file>.appimage` and run it as an ordinary user, with nothing else installed. The release also carries a .flatpak for a desktop-integrated install.',
  },
  {
    id: 'linux-qt',
    kind: '.appimage',
    install:
      'Same as the GNOME build, with Qt inside instead: `chmod +x ./<file>.appimage` and run it. A .flatpak is on the release too if you would rather install it through the desktop’s package system.',
  },
];
// Each card's heading and OS come from the platform table (src/lib/platforms.mjs); this page
// contributes the artifact kind and the install note, which are download-page concerns.
const targets = packaging.map((t) => ({
  ...t,
  store: 'store' in t ? t.store : undefined,
  os: platformsById[t.id].os,
  name: platformsById[t.id].toolkit,
}));

// The store badges (public/badges/, the stores' own artwork). Apple's SVG is its plate edge to
// edge; Google's plate is a 135×40 rect inside a 155×60 box, so the style below scales it by 1.5
// and pulls the transparent margin out, and the two plates come out the same height.
const stores = {
  apple: { href: site.showcaseAppStore, src: url('badges/apple-app-store.svg'), alt: 'Download on the App Store' },
  google: { href: site.showcasePlayStore, src: url('badges/google-play-store.svg'), alt: 'Get it on Google Play' },
};

function human(bytes: number): string {
  if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  if (bytes >= 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${bytes} B`;
}
// Render `backticked` fragments of the install notes as <code>.
function richInstall(text: string): (string | { code: string })[] {
  return text.split('`').map((part, i) => (i % 2 ? { code: part } : part));
}
---
<BaseLayout title="Showcase downloads" description="Launch the Day Showcase on the web, get it from the App Store or Google Play, or install a packaged build for Android, iOS, HarmonyOS, macOS, Windows, and Linux, with approximate sizes and one-line install commands." active="showcase">
  <section class="section dl-hero">
    <div class="container">
      <p class="eyebrow">Showcase downloads</p>
      <h1 class="dl-title">The same app the <a href={galleryHref}>gallery</a> shows, <span class="accent-text">installed on your machine</span>.</h1>
      <p class="lead">
        Every package below comes from one Rust codebase, packaged with <code>day pack</code> for
        each platform's native format and driven end to end by CI. The App Store and Google Play
        builds install like any other app, and so does the signed and notarized macOS build; the
        rest are development builds, so those cards note how to get past the platform's
        unsigned-app guard.
      </p>
      <p class="dl-actions">
        <a class="btn btn-primary" href={site.showcaseWeb}>Launch on the web →</a>
        <a class="store-badge store-badge-apple" href={stores.apple.href} aria-label={stores.apple.alt}>
          <img src={stores.apple.src} alt={stores.apple.alt} />
        </a>
        <a class="store-badge store-badge-google" href={stores.google.href} aria-label={stores.google.alt}>
          <img src={stores.google.src} alt={stores.google.alt} />
        </a>
      </p>
      {release ? (
        <p class="dl-note">
          Every link below downloads from the latest showcase release, whichever that is when you
          click it. The names and sizes were read from <a href={release.url}>{release.tag}</a> of{' '}
          {new Date(release.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })},
          so treat the sizes as approximate. Downloads are served from GitHub.
        </p>
      ) : (
        <p class="dl-note">
          Preview build: the packages come from the latest release, which this build could not
          reach. It shows the layout with placeholders.
        </p>
      )}
    </div>
  </section>

  <section class="section dl-quick">
    <div class="container">
      <h2 class="dl-quick-title">Quick start</h2>
      <p class="dl-quick-lead">Downloads, unpacks, and launches the app.</p>

      {/* Radio inputs rather than buttons, so the tabs work with the stylesheet alone — the
          script below only moves the selection. Without JavaScript the page still switches. */}
      <div class="qs">
        <input class="qs-radio" type="radio" name="qs-os" id="qs-unix" checked />
        <input class="qs-radio" type="radio" name="qs-os" id="qs-win" />
        <div class="qs-tabs">
          <label class="qs-tab" for="qs-unix">macOS / Linux</label>
          <label class="qs-tab" for="qs-win">Windows</label>
        </div>

        <div class="qs-panel qs-panel-unix">
          <CopyCommand cmd={`curl -fsSL ${unixCmdUrl} | bash`} />
        </div>

        <div class="qs-panel qs-panel-win">
          <CopyCommand cmd={`irm ${winCmdUrl} | iex`} />
        </div>
      </div>
    </div>
  </section>

  {/* Preselect the tab for the visitor's OS. Inline and immediately after the markup, so it runs
      during parse and the wrong tab is never painted first. `userAgentData` is the modern answer
      and `platform` the one that still works in Safari and Firefox; the user agent string is the
      last resort. Anything that is not Windows keeps the default. */}
  <script is:inline>
    (function () {
      var nav = window.navigator;
      var os = (nav.userAgentData && nav.userAgentData.platform) || nav.platform || nav.userAgent || '';
      if (/win/i.test(os)) {
        var win = document.getElementById('qs-win');
        if (win) win.checked = true;
      }

      // Copy to clipboard, with the button itself as the confirmation — a checkmark and "Copied",
      // reverted after a moment. `navigator.clipboard` needs a secure context, so the whole
      // control is REMOVED when it is unavailable rather than left to fail on click: a copy
      // button that silently does nothing is worse than no copy button.
      var buttons = document.querySelectorAll('.qs-copy');
      if (!navigator.clipboard) {
        buttons.forEach(function (b) { b.remove(); });
        return;
      }
      buttons.forEach(function (button) {
        var label = button.querySelector('.qs-copy-label');
        var idle = label.textContent;
        var timer;
        button.addEventListener('click', function () {
          navigator.clipboard.writeText(button.dataset.cmd).then(function () {
            button.classList.add('is-copied');
            label.textContent = 'Copied';
            clearTimeout(timer);
            timer = setTimeout(function () {
              button.classList.remove('is-copied');
              label.textContent = idle;
            }, 2000);
          });
        });
      });
    })();
  </script>

  <section class="section">
    <div class="container">
      <div class="dl-grid">
        <article class="dl-card" data-pf="web-dom">
          <div class="dl-head">
            <PlatformIcon id="web-dom" class="dl-icon" />
            <div class="dl-headings">
              <p class="dl-os">Web</p>
              <h2 class="dl-name">DOM</h2>
              <code class="dl-id">web-dom</code>
            </div>
          </div>
          <p class="dl-install">
            The WebAssembly build runs in the browser; this site hosts it as static files.
          </p>
          <p class="dl-files">
            <a class="btn btn-primary dl-btn" href={site.showcaseWeb}>Launch on the web →</a>
          </p>
        </article>
        {targets.map((t) => {
          const files = byId.get(t.id) ?? [];
          return (
            <article class="dl-card" data-pf={t.id}>
              <div class="dl-head">
                <PlatformIcon id={t.id} class="dl-icon" />
                <div class="dl-headings">
                  <p class="dl-os">{t.os}</p>
                  <h2 class="dl-name">{t.name}</h2>
                  <code class="dl-id">{t.id}</code>
                </div>
              </div>
              <p class="dl-install">
                {richInstall(t.install).map((part) =>
                  typeof part === 'string' ? part : <code>{part.code}</code>,
                )}
              </p>
              {t.store && (
                <p class="dl-store">
                  <a class={`store-badge store-badge-${t.store}`} href={stores[t.store].href} aria-label={stores[t.store].alt}>
                    <img src={stores[t.store].src} alt={stores[t.store].alt} />
                  </a>
                </p>
              )}
              {files.length > 0 ? (
                <ul class="dl-files">
                  {files.map((f) => (
                    <li>
                      <a class="dl-file" href={f.href}>⤓ {f.name}</a>
                      <span class="dl-size" title="Size when this page was built">≈{human(f.bytes)}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="dl-missing">Packaged as {t.kind}, but not attached to {release ? release.tag : 'the latest release'}.</p>
              )}
            </article>
          );
        })}
      </div>
      <p class="dl-verify">
        Verify a download against the <code>SHA256SUMS</code> file attached to the same release:{' '}
        <code>shasum -a 256 &lt;file&gt;</code> (macOS/Linux) or{' '}
        <code>Get-FileHash &lt;file&gt;</code> (Windows PowerShell) must print the digest listed
        there for that name. The checksums live with the release rather than on this page, so they
        describe the file you actually downloaded.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .dl-hero { padding-bottom: 8px; }
  .dl-title { font-size: clamp(1.9rem, 4vw, 2.8rem); margin: 0 0 16px; }
  .dl-title a { color: inherit; text-decoration: underline; text-decoration-color: var(--brand); }
  .dl-note { color: var(--faint); font-size: 0.92rem; }
  .dl-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin: 18px 0 8px; }

  /* A store badge at a fixed PLATE height (the same treatment as the daysite template's
     StoreBadge): Apple's artwork fills its box, Google's carries a quarter of the plate height
     as transparent margin on every side, pulled out with negative margins — never clipped. */
  .store-badge { --h: 42px; display: inline-block; height: var(--h); transition: transform 0.15s ease; }
  .store-badge:hover { transform: scale(1.03); }
  .store-badge:focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; border-radius: 8px; }
  .store-badge img { display: block; max-width: none; width: auto; height: var(--h); }
  .store-badge-google img { height: calc(var(--h) * 1.5); width: calc(var(--h) * 1.5 * 155 / 60); margin: calc(var(--h) * -0.25); }
  .dl-store { margin: 0 0 12px; }
  .dl-store .store-badge { --h: 38px; }

  .dl-quick { padding-top: 12px; padding-bottom: 12px; }
  .dl-quick-title { font-size: 1.35rem; margin: 0 0 10px; }
  .dl-quick-lead { margin: 0 0 14px; max-width: 68ch; color: var(--faint); }
  /* The command block and its Copy button style themselves (components/CopyCommand.astro). */

  /* The OS picker. The radios drive everything and stay in the accessibility tree — clipped
     rather than `display: none`, which would take them out of it and off the keyboard. */
  .qs-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .qs-tabs { display: flex; gap: 4px; margin: 0 0 12px; flex-wrap: wrap; }
  .qs-tab {
    cursor: pointer;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 0.92rem;
    color: var(--faint);
    background: var(--surface);
    user-select: none;
  }
  .qs-tab:hover { color: inherit; }
  .qs-panel { display: none; }
  #qs-unix:checked ~ .qs-tabs .qs-tab[for='qs-unix'],
  #qs-win:checked ~ .qs-tabs .qs-tab[for='qs-win'] {
    color: inherit;
    border-color: var(--brand);
    background: var(--surface-2);
  }
  /* Focus follows the radio, which is invisible — so the ring has to be drawn on its label. */
  #qs-unix:focus-visible ~ .qs-tabs .qs-tab[for='qs-unix'],
  #qs-win:focus-visible ~ .qs-tabs .qs-tab[for='qs-win'] {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  #qs-unix:checked ~ .qs-panel-unix,
  #qs-win:checked ~ .qs-panel-win {
    display: block;
  }

  .dl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 760px) { .dl-grid { grid-template-columns: 1fr; } }
  .dl-card {
    border: 1px solid var(--border-soft);
    border-top: 3px solid var(--pf, var(--brand));
    border-radius: var(--radius);
    padding: 18px 20px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .dl-os {
    margin: 0 0 2px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--pf, var(--brand)) 78%, var(--text));
  }
  /* The mark sits beside the three title rows, centered against the block as a whole. */
  .dl-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
  .dl-headings { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  /* :global — the <svg> lives in PlatformIcon's template, so it carries that component's
     scope attribute, not this page's, and an unscoped `.dl-icon` nav host never matches it. */
  .dl-card :global(.dl-icon) {
    width: 38px;
    height: 38px;
    color: color-mix(in srgb, var(--pf, var(--brand)) 78%, var(--text));
  }
  .dl-name { margin: 0 0 6px; font-size: 1.15rem; }
  .dl-id {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.76rem;
    padding: 0.1em 0.45em;
    border-radius: 6px;
    color: color-mix(in srgb, var(--pf, var(--brand)) 78%, var(--text));
    background: color-mix(in srgb, var(--pf, var(--brand)) 13%, transparent);
  }
  .dl-install { margin: 10px 0 12px; color: var(--muted); font-size: 0.9rem; line-height: 1.55; }
  .dl-install code, .dl-verify code { font-size: 0.85em; }

  .dl-files { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .dl-files li { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; row-gap: 2px; }
  .dl-file { font-weight: 650; }
  .dl-size { color: var(--faint); font-size: 0.85rem; }
  .dl-missing { margin: auto 0 0; color: var(--faint); font-size: 0.88rem; font-style: italic; }
  .dl-btn { align-self: flex-start; }
  .dl-verify { margin-top: 22px; color: var(--muted); font-size: 0.9rem; }
</style>
