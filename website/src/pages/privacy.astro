import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';

// The policy for the two things Daybrite operates: the `day` command-line tool and this site.
// An app built with Day belongs to whoever publishes it, and its store listing points at that
// publisher's own policy — so no app is described here.
---
<BaseLayout
  title="Privacy"
  description="How the day command-line tool checks for updates and how daybrite.dev uses GoatCounter for website analytics."
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy policy</h1>
      <p class="lead">
        This policy covers the <code>day</code> command-line tool and this website. The CLI checks
        for updates; the website uses GoatCounter to measure visits. Their network requests and
        data use are described below.
      </p>

      <h2>The day CLI</h2>
      <p>
        <code>day</code> runs on your machine, on the project in front of it. The one request it
        makes on its own account is a version check against{' '}
        <a href="https://crates.io">crates.io</a>, which asks what the current release of
        <code>day-cli</code> is and prints a line when yours is older. Setting
        <code>DAY_NO_UPDATE_CHECK</code> to any value turns it off, and it is skipped already in
        development builds and whenever a command prints machine-readable output.
      </p>
      <p>
        Everything else that reaches the network is a tool <code>day</code> runs for you, when the
        command you typed asks for it: cargo fetching crates, git cloning a template repository you
        named, the platform toolchains fetching their SDKs, fastlane uploading a build you told it
        to upload. Each one sends what it sends under its own policy.
      </p>
      <p>
        What <code>day</code> writes stays on your machine: build outputs under the project's
        <code>build/</code> directory, and clones of anything you asked it to fetch under the
        platform's standard cache directory (<code>$XDG_CACHE_HOME/day</code>,
        <code>~/.cache/day</code>, or <code>%LOCALAPPDATA%\day</code>). Deleting those directories
        is the whole of removing it.
      </p>

      <h2>This website</h2>
      <p>
        daybrite.dev is a set of static pages served by GitHub Pages. Its search index runs in your
        browser rather than on a server. A theme you pick with the light/dark control is remembered
        in your browser's local storage and goes nowhere else. GitHub serves the files and records
        requests in its own logs under{' '}
        <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">
          GitHub's privacy statement</a>.
      </p>
      <p>
        We use <a href="https://www.goatcounter.com">GoatCounter</a> to measure which pages people
        visit and how they reach the site. Your browser loads its analytics script and sends page
        information, including the page address, title, referrer, and screen width, to our
        <code>daybrite</code> GoatCounter account. GoatCounter also derives browser, operating-system,
        language, and approximate location statistics from the request.
      </p>
      <p>
        GoatCounter does not use cookies or store a tracking identifier in your browser. It
        temporarily processes IP addresses and browser information to distinguish visits; see{' '}
        <a href="https://www.goatcounter.com/help/privacy">GoatCounter's privacy policy</a> for
        details about processing and storage.
      </p>
      <p>
        The screenshot gallery links each capture where the app that took it publishes it, so
        opening a gallery page fetches those images from those sites, and they see the request.
      </p>

      <h2>Apps built with Day</h2>
      <p>
        An app someone builds with Day is that publisher's, and this policy says nothing about it.
        Its store listing points at the policy its own publisher wrote.
      </p>

      <h2>Changes</h2>
      <p>
        If this policy changes, the new version replaces this page and the date below changes with
        it. The tool and this site are open source, so any change to what either one sends is
        visible in the commit history.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy: <a href="mailto:hello@daybrite.dev">hello@daybrite.dev</a>, or
        open an issue on <a href="https://github.com/daybrite/day">GitHub</a>.
      </p>
      <p class="gen">Last updated 29 October 2026.</p>
      <p><a href={url('')}>← Back to daybrite.dev</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose { max-width: 62rem; }
  .prose h2 { margin-top: 2rem; }
  .gen { color: var(--muted); font-size: 0.9rem; }
</style>
