{
  "name": "day-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-SA-4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:site && npm run build:api",
    "build:force": "npm run build:site:force && npm run build:api",
    "build:site": "astro build && pagefind --site dist",
    "build:site:force": "astro build --force && pagefind --site dist",
    "build:api": "bash ../scripts/build-api-docs.sh --out website/dist/api && node scripts/check-api-bundle.mjs && python3 -B ../scripts/docs/check-api-links.py",
    "api:dev": "bash ../scripts/build-api-docs.sh --out website/public/api",
    "linkcheck": "node scripts/linkcheck.mjs",
    "preview": "astro preview",
    "assemble": "node scripts/assemble-gallery.mjs",
    "astro": "astro",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:test": "node --test scripts/docs-check.test.mjs scripts/target-labels.test.mjs",
    "docs:architecture": "node scripts/check-content-routes.mjs && node --test scripts/content-routes.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.3",
    "@astrojs/mdx": "^7.0.6",
    "astro": "^7.2.3"
  },
  "devDependencies": {
    "linkinator": "^6.3.0",
    "pagefind": "^1.3.0"
  }
}
